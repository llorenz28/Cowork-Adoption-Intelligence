{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json","name":"mv_ax_ax_narrative","position":{"x":16,"y":628,"z":30000,"height":80,"width":1248,"tabOrder":64000},"visual":{"visualType":"textbox","objects":{"general":[{"properties":{"paragraphs":[{"textRuns":[{"value":"Business outcomes at task grain","textStyle":{"fontWeight":"bold","fontSize":"13pt","color":"#4B2D83"}}]},{"textRuns":[{"value":"Each task is counted once by ThreadId. Customer-facing tools are separated from agent orchestration, and the highest-priority business outcome represents each task. General requests, orchestration-only tasks, and unclassified tools remain visible instead of being hidden. Assisted hours use the selected behavior midpoint with the published category low/high envelope.","textStyle":{"fontSize":"8pt","color":"#1B1F27"}}]}]}}]},"visualContainerObjects":{"background":[{"properties":{"show":{"expr":{"Literal":{"Value":"true"}}},"color":{"solid":{"color":{"expr":{"Literal":{"Value":"'#F3EFF8'"}}}}},"transparency":{"expr":{"Literal":{"Value":"0D"}}}}}],"border":[{"properties":{"show":{"expr":{"Literal":{"Value":"true"}}},"color":{"solid":{"color":{"expr":{"Literal":{"Value":"'#C5B3DA'"}}}}},"radius":{"expr":{"Literal":{"Value":"4D"}}},"width":{"expr":{"Literal":{"Value":"1D"}}}}}],"visualHeader":[{"properties":{"show":{"expr":{"Literal":{"Value":"false"}}}}}],"padding":[{"properties":{"top":{"expr":{"Literal":{"Value":"8D"}}},"bottom":{"expr":{"Literal":{"Value":"8D"}}},"left":{"expr":{"Literal":{"Value":"12D"}}},"right":{"expr":{"Literal":{"Value":"12D"}}}}}]}}}