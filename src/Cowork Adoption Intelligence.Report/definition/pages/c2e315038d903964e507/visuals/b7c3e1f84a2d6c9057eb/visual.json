        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read power-user share",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#4B2D83"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Definition: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Power users are the top 10% of users by rolling 12-week prompt volume who were active in at least 9 of those 12 weeks.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1B1F27"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Minimum evidence: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "At least 20 active users are required for tiering. Smaller populations return Insufficient sample instead of assigning Power, Habitual, Novice, or Low tiers.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#1B1F27"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt",
                      "color": "#1B1F27"
                    }
                  },
                  {
                    "value": "Use the percentage as an enablement signal for sustained use, not an employee-performance rating. Compare a department with itself over time and read the underlying population size.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#1B1F27"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
