	/// Percentile rank of prompt volume within the current selected user population.
	/// Returns blank below the same 20-active-user floor used by Value Percentile.
	measure 'Cowork User Prompt Percentile' =
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _currentPrompts =
			    CALCULATE(
			        SUM(Fact_CoworkUserDayModel[PromptCount]),
			        _modelFilter
			    )
			VAR _population =
			    FILTER(
			        CALCULATETABLE(
			            ADDCOLUMNS(
			                VALUES(Dim_User[UserKey]),
			                "__PromptCount",
			                    CALCULATE(
			                        SUM(Fact_CoworkUserDayModel[PromptCount]),
			                        _modelFilter
			                    )
			            ),
			            REMOVEFILTERS(Dim_User[UserKey]),
			            REMOVEFILTERS(Dim_User[Department])
			        ),
			        NOT ISBLANK(Dim_User[UserKey]) && [__PromptCount] > 0
			    )
			VAR _pop = COUNTROWS(_population)
			VAR _rank =
			    RANKX(
			        _population,
			        [__PromptCount],
			        _currentPrompts,
			        DESC
			    )
			RETURN
			    IF(_pop < 20, BLANK(), DIVIDE(_pop - _rank, _pop - 1))
		formatString: 0.0%
		isHidden
		lineageTag: 5701e3e4-31d9-4ff8-a7ae-e6074b1edb18

	/// Rolling 12-week Cowork usage tier, evaluated per user and per week.
	measure 'Cowork User Usage Tier' =
			VAR _userKey = SELECTEDVALUE(Dim_User[UserKey])
			VAR _axisWeek = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _endWeek =
			    IF(
			        NOT ISBLANK(_axisWeek),
			        _axisWeek,
			        MAXX(
			            FILTER(
			                ALLSELECTED(Dim_Date[WeekStart]),
			                CALCULATE(
			                    [Cowork Aggregate Active Users],
			                    REMOVEFILTERS(Dim_User[UserKey]),
			                    REMOVEFILTERS(Dim_User[Department])
			                ) > 0
			            ),
			            Dim_Date[WeekStart]
			        )
			    )
			VAR _startDate = _endWeek - 77
			VAR _endDate = _endWeek + 6
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _prompts =
			    CALCULATE(
			        SUM(Fact_CoworkUserDayModel[PromptCount]),
			        REMOVEFILTERS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], _startDate, _endDate),
			        _modelFilter
			    )
			VAR _activeWeeks =
			    CALCULATE(
			        DISTINCTCOUNT(Fact_CoworkUserDayModel[WeekStartDate]),
			        REMOVEFILTERS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], _startDate, _endDate),
			        _modelFilter
			    )
			VAR _p =
			    CALCULATE(
			        [Cowork User Prompt Percentile],
			        REMOVEFILTERS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], _startDate, _endDate)
			    )
			RETURN
			    IF(
			        ISBLANK(_userKey) || ISBLANK(_endWeek),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            COALESCE(_prompts, 0) = 0, "Inactive",
			            ISBLANK(_p), "Insufficient sample",
			            _p >= 0.90 && _activeWeeks >= 9, "Power users",
			            _p >= 0.60 && _activeWeeks >= 9, "Habitual users",
			            _p >= 0.20, "Novice users",
			            "Low users"
			        )
			    )
		isHidden
		lineageTag: 094dcc14-e2b4-502a-a275-70d2840d7163

	measure 'Cowork Power Users' =
			VAR _axisWeek = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _endWeek =
			    IF(
			        NOT ISBLANK(_axisWeek),
			        _axisWeek,
			        MAXX(
			            FILTER(
			                ALLSELECTED(Dim_Date[WeekStart]),
			                CALCULATE(
			                    [Cowork Aggregate Active Users],
			                    REMOVEFILTERS(Dim_User[UserKey]),
			                    REMOVEFILTERS(Dim_User[Department])
			                ) > 0
			            ),
			            Dim_Date[WeekStart]
			        )
			    )
			VAR _startDate = _endWeek - 77
			VAR _endDate = _endWeek + 6
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _benchmarkStats =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES(Dim_User[UserKey]),
			            "__PromptCount", CALCULATE(SUM(Fact_CoworkUserDayModel[PromptCount]), _modelFilter),
			            "__ActiveWeeks", CALCULATE(DISTINCTCOUNT(Fact_CoworkUserDayModel[WeekStartDate]), _modelFilter)
			        ),
			        REMOVEFILTERS(Dim_User[UserKey]),
			        REMOVEFILTERS(Dim_User[Department]),
			        REMOVEFILTERS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], _startDate, _endDate)
			    )
			VAR _activePopulation = FILTER(_benchmarkStats, [__PromptCount] > 0)
			VAR _populationSize = COUNTROWS(_activePopulation)
			VAR _visibleStats =
			    ADDCOLUMNS(
			        FILTER(VALUES(Dim_User[UserKey]), NOT ISBLANK(Dim_User[UserKey])),
			        "__VisiblePrompts",
			            VAR _key = Dim_User[UserKey]
			            RETURN MAXX(FILTER(_benchmarkStats, Dim_User[UserKey] = _key), [__PromptCount]),
			        "__VisibleWeeks",
			            VAR _key = Dim_User[UserKey]
			            RETURN MAXX(FILTER(_benchmarkStats, Dim_User[UserKey] = _key), [__ActiveWeeks])
			    )
			VAR _scored =
			    ADDCOLUMNS(
			        _visibleStats,
			        "__Percentile",
			            VAR _prompts = [__VisiblePrompts]
			            VAR _rank = RANKX(_activePopulation, [__PromptCount], _prompts, DESC, SKIP)
			            RETURN IF(_populationSize < 20, BLANK(), DIVIDE(_populationSize - _rank, _populationSize - 1))
			    )
			RETURN
			    IF(
			        ISBLANK(_endWeek),
			        BLANK(),
			        COUNTROWS(
			            FILTER(
			                _scored,
			                [__VisiblePrompts] > 0 &&
			                [__Percentile] >= 0.90 &&
			                [__VisibleWeeks] >= 9
			            )
			        )
			    )
		formatString: #,0
		lineageTag: 216e4ec8-16c0-5791-9d7d-e253665f6da8

