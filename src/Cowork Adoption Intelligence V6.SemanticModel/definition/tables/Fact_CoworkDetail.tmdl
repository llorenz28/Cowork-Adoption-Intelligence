			            VAR _rank = RANKX(_activePopulation, [__PromptCount], _prompts, DESC, SKIP)
			            RETURN IF(_populationSize < 20, BLANK(), DIVIDE(_populationSize - _rank, _populationSize - 1))
			    )
			RETURN
			    IF(
			        ISBLANK(_endWeek),
			        BLANK(),
			        COUNTROWS(
			            FILTER(
			                _scored,
			                [__VisiblePrompts] > 0 &&
			                [__Percentile] >= 0.60 &&
			                [__Percentile] < 0.90 &&
			                [__VisibleWeeks] >= 9
			            )
			        )
			    )
		formatString: #,0
		lineageTag: 89ba9b26-b5fe-554f-8195-a30e156c664a

	measure 'Cowork Novice Users' =
			VAR _axisWeek = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _endWeek =
			    IF(
			        NOT ISBLANK(_axisWeek),
			        _axisWeek,
			        MAXX(
			            FILTER(
			                ALLSELECTED(Dim_Date[WeekStart]),
			                CALCULATE(
			                    [Cowork Aggregate Active Users],
			                    REMOVEFILTERS(Dim_User[UserKey]),
			                    REMOVEFILTERS(Dim_User[Department])
			                ) > 0
			            ),
			            Dim_Date[WeekStart]
			        )
			    )
			VAR _startDate = _endWeek - 77
			VAR _endDate = _endWeek + 6
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _benchmarkStats =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES(Dim_User[UserKey]),
			            "__PromptCount", CALCULATE(SUM(Fact_CoworkUserDayModel[PromptCount]), _modelFilter),
			            "__ActiveWeeks", CALCULATE(DISTINCTCOUNT(Fact_CoworkUserDayModel[WeekStartDate]), _modelFilter)
			        ),
			        REMOVEFILTERS(Dim_User[UserKey]),
			        REMOVEFILTERS(Dim_User[Department]),
			        REMOVEFILTERS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], _startDate, _endDate)
			    )
			VAR _activePopulation = FILTER(_benchmarkStats, [__PromptCount] > 0)
			VAR _populationSize = COUNTROWS(_activePopulation)
			VAR _visibleStats =
			    ADDCOLUMNS(
			        FILTER(VALUES(Dim_User[UserKey]), NOT ISBLANK(Dim_User[UserKey])),
			        "__VisiblePrompts",
			            VAR _key = Dim_User[UserKey]
			            RETURN MAXX(FILTER(_benchmarkStats, Dim_User[UserKey] = _key), [__PromptCount]),
			        "__VisibleWeeks",
			            VAR _key = Dim_User[UserKey]
			            RETURN MAXX(FILTER(_benchmarkStats, Dim_User[UserKey] = _key), [__ActiveWeeks])
			    )
			VAR _scored =
			    ADDCOLUMNS(
			        _visibleStats,
			        "__Percentile",
			            VAR _prompts = [__VisiblePrompts]
			            VAR _rank = RANKX(_activePopulation, [__PromptCount], _prompts, DESC, SKIP)
			            RETURN IF(_populationSize < 20, BLANK(), DIVIDE(_populationSize - _rank, _populationSize - 1))
			    )
			RETURN
			    IF(
			        ISBLANK(_endWeek),
			        BLANK(),
			        COUNTROWS(
			            FILTER(
			                _scored,
			                [__VisiblePrompts] > 0 &&
			                [__Percentile] >= 0.20 &&
			                ([__Percentile] < 0.60 || [__VisibleWeeks] < 9)
			            )
			        )
			    )
		formatString: #,0
		lineageTag: 0bd3894e-c747-5bea-94f5-881c1109bd4b

