			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _currentWeek - 7
			    )
			RETURN DIVIDE(_currentPrompts - _previousPrompts, _previousPrompts)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 297bba53-8bc3-5b97-a13c-79fc330b7964

