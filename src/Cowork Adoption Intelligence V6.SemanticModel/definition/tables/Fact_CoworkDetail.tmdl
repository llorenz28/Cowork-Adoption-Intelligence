	partition Fact_CoworkDetail = calculated
		mode: import
		source =
				ADDCOLUMNS(
					FILTER('Fact_CopilotAuditRaw', TRIM('Fact_CopilotAuditRaw'[AppHost]) = "cowork"),
					"Category", COALESCE(LOOKUPVALUE(CoworkClassification[Category], CoworkClassification[RecordId], 'Fact_CopilotAuditRaw'[RecordId]), "General assistance / Other"),
					"CategorySignal", COALESCE(LOOKUPVALUE(CoworkClassification[CategorySignal], CoworkClassification[RecordId], 'Fact_CopilotAuditRaw'[RecordId]), "No signal"),
					"MappingConfidence", COALESCE(LOOKUPVALUE(CoworkClassification[MappingConfidence], CoworkClassification[RecordId], 'Fact_CopilotAuditRaw'[RecordId]), "None"),
					"SkillDisplayName", LOOKUPVALUE(CoworkClassification[SkillDisplayName], CoworkClassification[RecordId], 'Fact_CopilotAuditRaw'[RecordId]),
					"ActivityDetail", LOOKUPVALUE(CoworkClassification[ActivityDetail], CoworkClassification[RecordId], 'Fact_CopilotAuditRaw'[RecordId]),
					"IsUnmapped", COALESCE(LOOKUPVALUE(CoworkClassification[CategorySignal], CoworkClassification[RecordId], 'Fact_CopilotAuditRaw'[RecordId]), "No signal") = "No signal",
					"CategoryKey", COALESCE(LOOKUPVALUE(CoworkClassification[CategoryKey], CoworkClassification[RecordId], 'Fact_CopilotAuditRaw'[RecordId]), 8)
				)
