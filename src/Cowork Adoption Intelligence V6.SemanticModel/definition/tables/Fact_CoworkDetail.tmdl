	/// Users whose first observed Cowork activity occurred in the selected week.
	measure 'Cowork Weekly New Users (Last 12 Weeks)' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Aggregate Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			VAR _currentUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week,
			        _modelFilter
			    )
			VAR _priorUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] < _week,
			        _modelFilter
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        COALESCE(COUNTROWS(EXCEPT(_currentUsers, _priorUsers)), 0)
			    )
		formatString: #,0
		lineageTag: 98a0caf4-a7de-4557-81dd-4b663addd748

	/// Users active in both the selected week and the immediately preceding week.
	measure 'Cowork Weekly Retained Users (Last 12 Weeks)' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Aggregate Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			VAR _currentUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week,
			        _modelFilter
			    )
			VAR _previousUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week - 7,
			        _modelFilter
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        COALESCE(COUNTROWS(INTERSECT(_currentUsers, _previousUsers)), 0)
			    )
		formatString: #,0
		lineageTag: 20158a8c-fbce-40f2-aa98-d0ab7a97dcce

	/// Users active in the selected week after missing the prior week but having earlier activity.
	measure 'Cowork Weekly Resurrected Users (Last 12 Weeks)' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Aggregate Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			VAR _currentUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week,
			        _modelFilter
			    )
			VAR _previousUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week - 7,
			        _modelFilter
			    )
			VAR _earlierUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] < _week - 7,
			        _modelFilter
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        COALESCE(
			            COUNTROWS(
			                INTERSECT(
			                    EXCEPT(_currentUsers, _previousUsers),
			                    _earlierUsers
			                )
			            ),
			            0
			        )
			    )
		formatString: #,0
		lineageTag: b39b6955-e7c2-4607-a917-cd2dd59b25a3

	/// Prior-week users who did not return in the selected week, shown below zero.
	measure 'Cowork Weekly Churned Users (Last 12 Weeks)' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Aggregate Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			VAR _currentUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week,
			        _modelFilter
			    )
			VAR _previousUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkUserDayModel[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week - 7,
			        _modelFilter
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
