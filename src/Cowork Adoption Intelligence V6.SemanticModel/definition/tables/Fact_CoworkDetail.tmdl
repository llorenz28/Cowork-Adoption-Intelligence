	measure 'Cowork Weekly Return Rate' =
			VAR _axisWeek = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _hasModelFilter = ISFILTERED(Fact_CoworkDetail[ModelProviderName])
			VAR _models = FILTERS(Fact_CoworkDetail[ModelProviderName])
			VAR _modelFilter =
			    FILTER(
			        ALL(Fact_CoworkUserDayModel[ModelProviderName]),
			        NOT _hasModelFilter || Fact_CoworkUserDayModel[ModelProviderName] IN _models
			    )
			VAR _currentWeek =
			    IF(
			        NOT ISBLANK(_axisWeek),
			        _axisWeek,
			        MAXX(
			            FILTER(
			                ALLSELECTED(Dim_Date[WeekStart]),
			                CALCULATE([Cowork Aggregate Active Users]) > 0
			            ),
			            Dim_Date[WeekStart]
			        )
			    )
			VAR _previousWeek = _currentWeek - 7
			VAR _currentUsers =
			    CALCULATETABLE(
			        VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _currentWeek,
			        _modelFilter
			    )
			VAR _previousUsers =
			    CALCULATETABLE(
			        VALUES(Fact_CoworkUserDayModel[Audit_UserId]),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _previousWeek,
			        _modelFilter
			    )
			RETURN
			    DIVIDE(
			        COUNTROWS(INTERSECT(_currentUsers, _previousUsers)),
			        COUNTROWS(_previousUsers)
			    )
		formatString: 0.0%
		lineageTag: 7aee0884-46b0-5518-b46b-2a03cf26f65d

	measure 'Cowork Licensed Adoption %' = DIVIDE([Cowork Active Users], [Licensed Users])
