	/// Average observed category tasks across users who performed at least one task in scope.
	measure 'Category Average Tasks per User' = DIVIDE([Champion Category Tasks], [Category User Count])
		formatString: #,0.0
		displayFolder: Category users
		lineageTag: 97fae4c2-d3a9-4b5d-a5f8-779f4b86e3b6

	/// Departments represented by users with observed tasks in the current category scope.
	measure 'Category Department Count' =
			COUNTROWS(
				FILTER(
					VALUES(Dim_User[Department]),
					NOT ISBLANK(Dim_User[Department]) &&
					CALCULATE([Champion Category Tasks]) > 0
				)
			)
		formatString: #,0
		displayFolder: Category users
		lineageTag: e893c588-5d58-4aae-8fc4-b50e46c3c364

	/// User-row task value; blank suppresses users with no activity in the selected category.
	measure 'Category User Tasks' = IF([Champion Category Tasks] > 0, [Champion Category Tasks])
		formatString: #,0
		displayFolder: Category users
		lineageTag: b3e42aa0-46fd-459f-bf47-e285474657d8

	/// User-row active weeks; blank suppresses users with no activity in the selected category.
	measure 'Category User Active Weeks' = IF([Champion Category Tasks] > 0, [Champion Active Weeks])
		formatString: #,0
		displayFolder: Category users
		lineageTag: a8366277-a73d-4e31-8069-600b25e6be20

	/// User-row adoption stage shown only when the user has activity in the selected category.
	measure 'Category User Stage' = IF([Champion Category Tasks] > 0, [User Delegation Rung])
		displayFolder: Category users
		lineageTag: f177b1d5-f9e6-4c75-99bb-a50e0bc35c34

	/// User-row last activity shown only when the user has activity in the selected category.
	measure 'Category User Last Activity' = IF([Champion Category Tasks] > 0, [Champion Last Activity])
		formatString: mmm d, yyyy
		displayFolder: Category users
		lineageTag: 88da62fa-f736-45b7-8b11-b786e36277c4

	/// Number of distinct weeks with observed tasks in the current category context.
	measure 'Champion Active Weeks' = COUNTROWS(SUMMARIZE(Fact_CoworkThread, Fact_CoworkThread[WeekStartDate]))
		formatString: #,0
		displayFolder: Champions
		lineageTag: a61b07f5-600a-4d2e-ac99-4df8e006b3bb

	/// Latest date with an observed task in the current category context.
	measure 'Champion Last Activity' =
			MAXX(
				FILTER(
					VALUES(Dim_Date[Date]),
					CALCULATE([Champion Category Tasks]) > 0
				),
				Dim_Date[Date]
			)
		formatString: mmm d, yyyy
		displayFolder: Champions
		lineageTag: 6a0d13c4-364a-4196-98a0-0736fa58e58c

	/// Normalized 0-1 form of the existing measured delegation rung.
	measure 'Champion Delegation Score' = DIVIDE([Delegation Rung Order], 4)
		formatString: 0%
		displayFolder: Champions
		lineageTag: afed087d-105e-444e-98af-3c6cb1e6089c

	/// Evidence floor for champion ranking: at least three category tasks across two active weeks.
	measure 'Champion Eligible' =
			IF(
				[Champion Category Tasks] >= 3 &&
				[Champion Active Weeks] >= 2,
				1,
				0
			)
		formatString: 0
		displayFolder: Champions
		lineageTag: 3b60d3d1-70be-49a8-9c6f-99a091eab7d0

	/// Eligible users in the current visual and report filter context.
	measure 'Champion Eligible Users' =
			VAR _stats =
				SUMMARIZE(
					Fact_CoworkThread,
					Dim_User[UserKey],
					"__Tasks", COUNTROWS(Fact_CoworkThread),
					"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate])
				)
			RETURN
				COUNTROWS(
					FILTER(
						_stats,
						[__Tasks] >= 3 &&
						[__Weeks] >= 2
					)
				)
		formatString: #,0
		displayFolder: Champions
		lineageTag: 3d5a9204-a1a2-4135-a959-a45b2c57024f

	/// Percentile rank of category task volume across users while preserving date and category filters.
	measure 'Champion Activity Percentile' =
			VAR _stats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _population =
				FILTER(
					_stats,
					[__Tasks] >= 3 &&
					[__Weeks] >= 2
				)
			VAR _populationCount = COUNTROWS(_population)
			VAR _currentTasks = [Champion Category Tasks]
			VAR _currentWeeks = [Champion Active Weeks]
			VAR _rank =
				RANKX(
					_population,
					[__Tasks],
					_currentTasks,
					DESC,
					SKIP
				)
			RETURN
				IF(
					_currentTasks >= 3 &&
					_currentWeeks >= 2,
					IF(
						_populationCount <= 1,
						1,
						DIVIDE(_populationCount - _rank, _populationCount - 1)
					)
				)
		formatString: 0%
		displayFolder: Champions
		lineageTag: a69e9844-17f7-45ec-8928-02206d2ab51c

	/// Percentile rank of sustained weekly activity across users while preserving date and category filters.
	measure 'Champion Consistency Percentile' =
			VAR _stats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _population =
				FILTER(
					_stats,
					[__Tasks] >= 3 &&
					[__Weeks] >= 2
				)
			VAR _populationCount = COUNTROWS(_population)
			VAR _currentTasks = [Champion Category Tasks]
			VAR _currentWeeks = [Champion Active Weeks]
			VAR _rank =
				RANKX(
					_population,
					[__Weeks],
					_currentWeeks,
					DESC,
					SKIP
				)
			RETURN
				IF(
					_currentTasks >= 3 &&
					_currentWeeks >= 2,
					IF(
						_populationCount <= 1,
						1,
						DIVIDE(_populationCount - _rank, _populationCount - 1)
					)
				)
		formatString: 0%
		displayFolder: Champions
		lineageTag: 8f940701-4c3b-48b8-8384-2629de1a640a

	/// Transparent 0-100 evidence score: 40% category activity, 35% consistency, and 25% delegation maturity.
	measure 'Champion Evidence Score' =
			VAR _stats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _population =
				FILTER(
					_stats,
					[__Tasks] >= 3 &&
					[__Weeks] >= 2
				)
			VAR _populationCount = COUNTROWS(_population)
			VAR _currentTasks = [Champion Category Tasks]
			VAR _currentWeeks = [Champion Active Weeks]
			VAR _activityRank =
				RANKX(
					_population,
					[__Tasks],
					_currentTasks,
					DESC,
					SKIP
				)
			VAR _consistencyRank =
				RANKX(
					_population,
					[__Weeks],
					_currentWeeks,
					DESC,
					SKIP
				)
			VAR _activityPercentile =
				IF(
					_populationCount <= 1,
					1,
					DIVIDE(_populationCount - _activityRank, _populationCount - 1)
				)
			VAR _consistencyPercentile =
				IF(
					_populationCount <= 1,
					1,
					DIVIDE(_populationCount - _consistencyRank, _populationCount - 1)
				)
			RETURN
				IF(
					_currentTasks >= 3 &&
					_currentWeeks >= 2,
					100 * (
						0.40 * _activityPercentile +
						0.35 * _consistencyPercentile +
						0.25 * [Champion Delegation Score]
					)
				)
		formatString: 0.0
		displayFolder: Champions
		lineageTag: 318c46e0-d497-436e-85b2-bb69b3ab77c6

	/// Rank of an eligible user by champion evidence score inside the selected organization and category scope.
	measure 'Champion Evidence Rank' =
			VAR _baseStats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate]),
						"__MultiSkillTasks",
							CALCULATE(
								COUNTROWS(Fact_CoworkThread),
								Fact_CoworkThread[PluginCount] > 1
							),
						"__Duration", AVERAGE(Fact_CoworkThread[DurationMin])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _stats =
				ADDCOLUMNS(
					_baseStats,
					"__Delegation",
						VAR _tasks = [__Tasks]
						VAR _userKey = Dim_User[UserKey]
						VAR _scheduled =
							CALCULATE(
								[Reported Scheduled],
								REMOVEFILTERS(Dim_User),
								TREATAS({_userKey}, Dim_User[UserKey])
							)
						VAR _multiSkill = DIVIDE([__MultiSkillTasks], _tasks)
						VAR _duration = [__Duration]
						RETURN
							SWITCH(
								TRUE(),
								COALESCE(_tasks, 0) = 0, 0,
								_scheduled > 0, 1,
								_multiSkill >= 0.30, 0.75,
								_duration >= 5, 0.5,
								0.25
							)
				)
			VAR _population =
				FILTER(
					_stats,
					[__Tasks] >= 3 &&
					[__Weeks] >= 2
				)
			VAR _populationCount = COUNTROWS(_population)
			VAR _withPercentiles =
				ADDCOLUMNS(
					_population,
					"__ActivityPercentile",
						VAR _tasks = [__Tasks]
						VAR _rank = RANKX(_population, [__Tasks], _tasks, DESC, SKIP)
						RETURN IF(_populationCount <= 1, 1, DIVIDE(_populationCount - _rank, _populationCount - 1)),
					"__ConsistencyPercentile",
						VAR _weeks = [__Weeks]
						VAR _rank = RANKX(_population, [__Weeks], _weeks, DESC, SKIP)
						RETURN IF(_populationCount <= 1, 1, DIVIDE(_populationCount - _rank, _populationCount - 1))
				)
			VAR _scored =
				ADDCOLUMNS(
					_withPercentiles,
					"__Score",
						100 * (
							0.40 * [__ActivityPercentile] +
							0.35 * [__ConsistencyPercentile] +
							0.25 * [__Delegation]
						)
				)
			VAR _ranked =
				ADDCOLUMNS(
					_scored,
					"__RankValue",
						[__Score] * 1000000 - Dim_User[UserKey]
				)
			VAR _currentUser = SELECTEDVALUE(Dim_User[UserKey])
			VAR _currentRankValue =
				MAXX(
					FILTER(_ranked, Dim_User[UserKey] = _currentUser),
					[__RankValue]
				)
			RETURN
				IF(
					NOT ISBLANK(_currentRankValue),
					RANKX(
						_ranked,
						[__RankValue],
						_currentRankValue,
						DESC,
						DENSE
					)
				)
		formatString: #,0
		displayFolder: Champions
		lineageTag: 75cc59b0-ad67-4b8b-a575-5f285fb3680a

	/// Number of eligible users admitted by the selected Top 5/10/20 tier.
	measure 'Champion Cutoff Count' =
			VAR _stats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _populationCount =
				COUNTROWS(
					FILTER(
						_stats,
						[__Tasks] >= 3 &&
						[__Weeks] >= 2
					)
				)
			RETURN
				IF(
					_populationCount > 0,
					MIN(
						_populationCount,
						MAX(1, CEILING(_populationCount * [Champion Percent Selected], 1))
					)
				)
		formatString: #,0
		displayFolder: Champions
		lineageTag: d1dc4d57-10ef-4c6a-be7d-d3f3dacb4a98

	/// User-level flag for the selected champion tier.
	measure 'Is Champion Candidate' =
			IF(
				[Champion Eligible] = 1 &&
				[Champion Evidence Rank] <= [Champion Cutoff Count],
				1,
				0
			)
		formatString: 0
		displayFolder: Champions
		lineageTag: c65a7202-3ad8-46ed-b899-aad990928a56

	/// Potential champion count in the current visual context.
	measure 'Champion Candidates' =
			VAR _visibleUsers = VALUES(Dim_User[UserKey])
			VAR _baseStats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate]),
						"__MultiSkillTasks",
							CALCULATE(
								COUNTROWS(Fact_CoworkThread),
								Fact_CoworkThread[PluginCount] > 1
							),
						"__Duration", AVERAGE(Fact_CoworkThread[DurationMin])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _stats =
				ADDCOLUMNS(
					_baseStats,
					"__Delegation",
						VAR _tasks = [__Tasks]
						VAR _userKey = Dim_User[UserKey]
						VAR _scheduled =
							CALCULATE(
								[Reported Scheduled],
								REMOVEFILTERS(Dim_User),
								TREATAS({_userKey}, Dim_User[UserKey])
							)
						VAR _multiSkill = DIVIDE([__MultiSkillTasks], _tasks)
						VAR _duration = [__Duration]
						RETURN
							SWITCH(
								TRUE(),
								COALESCE(_tasks, 0) = 0, 0,
								_scheduled > 0, 1,
								_multiSkill >= 0.30, 0.75,
								_duration >= 5, 0.5,
								0.25
							)
				)
			VAR _population =
				FILTER(
					_stats,
					[__Tasks] >= 3 &&
					[__Weeks] >= 2
				)
			VAR _populationCount = COUNTROWS(_population)
			VAR _withPercentiles =
				ADDCOLUMNS(
					_population,
					"__ActivityPercentile",
						VAR _tasks = [__Tasks]
						VAR _rank = RANKX(_population, [__Tasks], _tasks, DESC, SKIP)
						RETURN IF(_populationCount <= 1, 1, DIVIDE(_populationCount - _rank, _populationCount - 1)),
					"__ConsistencyPercentile",
						VAR _weeks = [__Weeks]
						VAR _rank = RANKX(_population, [__Weeks], _weeks, DESC, SKIP)
						RETURN IF(_populationCount <= 1, 1, DIVIDE(_populationCount - _rank, _populationCount - 1))
				)
			VAR _scored =
				ADDCOLUMNS(
					_withPercentiles,
					"__Score",
						100 * (
							0.40 * [__ActivityPercentile] +
							0.35 * [__ConsistencyPercentile] +
							0.25 * [__Delegation]
						)
				)
			VAR _ranked =
				ADDCOLUMNS(
					_scored,
					"__Rank",
						VAR _rankValue = [__Score] * 1000000 - Dim_User[UserKey]
						RETURN
							RANKX(
								_scored,
								[__Score] * 1000000 - Dim_User[UserKey],
								_rankValue,
								DESC,
								DENSE
							)
				)
			VAR _cutoff =
				IF(
					_populationCount > 0,
					MIN(
						_populationCount,
						MAX(1, CEILING(_populationCount * [Champion Percent Selected], 1))
					)
				)
			RETURN
				COUNTROWS(
					FILTER(
						_ranked,
						[__Rank] <= _cutoff &&
						Dim_User[UserKey] IN _visibleUsers
					)
				)
		formatString: #,0
		displayFolder: Champions
		lineageTag: 5218cf0a-4e3d-4db0-8169-76b68792b96c

	/// Average category task volume across the currently displayed champion candidates.
	measure 'Average Tasks per Champion' =
			VAR _visibleUsers = VALUES(Dim_User[UserKey])
			VAR _baseStats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate]),
						"__MultiSkillTasks",
							CALCULATE(
								COUNTROWS(Fact_CoworkThread),
								Fact_CoworkThread[PluginCount] > 1
							),
						"__Duration", AVERAGE(Fact_CoworkThread[DurationMin])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _stats =
				ADDCOLUMNS(
					_baseStats,
					"__Delegation",
						VAR _tasks = [__Tasks]
						VAR _userKey = Dim_User[UserKey]
						VAR _scheduled =
							CALCULATE(
								[Reported Scheduled],
								REMOVEFILTERS(Dim_User),
								TREATAS({_userKey}, Dim_User[UserKey])
							)
						VAR _multiSkill = DIVIDE([__MultiSkillTasks], _tasks)
						VAR _duration = [__Duration]
						RETURN
							SWITCH(
								TRUE(),
								_scheduled > 0, 1,
								_multiSkill >= 0.30, 0.75,
								_duration >= 5, 0.5,
								0.25
							)
				)
			VAR _population = FILTER(_stats, [__Tasks] >= 3 && [__Weeks] >= 2)
			VAR _populationCount = COUNTROWS(_population)
			VAR _withPercentiles =
				ADDCOLUMNS(
					_population,
					"__ActivityPercentile",
						VAR _tasks = [__Tasks]
						VAR _rank = RANKX(_population, [__Tasks], _tasks, DESC, SKIP)
						RETURN IF(_populationCount <= 1, 1, DIVIDE(_populationCount - _rank, _populationCount - 1)),
					"__ConsistencyPercentile",
						VAR _weeks = [__Weeks]
						VAR _rank = RANKX(_population, [__Weeks], _weeks, DESC, SKIP)
						RETURN IF(_populationCount <= 1, 1, DIVIDE(_populationCount - _rank, _populationCount - 1))
				)
			VAR _scored =
				ADDCOLUMNS(
					_withPercentiles,
					"__Score",
						100 * (
							0.40 * [__ActivityPercentile] +
							0.35 * [__ConsistencyPercentile] +
							0.25 * [__Delegation]
						)
				)
			VAR _ranked =
				ADDCOLUMNS(
					_scored,
					"__Rank",
						VAR _rankValue = [__Score] * 1000000 - Dim_User[UserKey]
						RETURN RANKX(_scored, [__Score] * 1000000 - Dim_User[UserKey], _rankValue, DESC, DENSE)
				)
			VAR _cutoff =
				IF(
					_populationCount > 0,
					MIN(_populationCount, MAX(1, CEILING(_populationCount * [Champion Percent Selected], 1)))
				)
			RETURN
				AVERAGEX(
					FILTER(_ranked, [__Rank] <= _cutoff && Dim_User[UserKey] IN _visibleUsers),
					[__Tasks]
				)
		formatString: #,0.0
		displayFolder: Champions
		lineageTag: 0e1b2b1f-5fb2-431d-b951-b536efcacd93

