	measure 'VS Finding' =
			VAR _ahead = [VS Users Ahead]
			VAR _total = [Value Users]
			RETURN
			SWITCH(TRUE(),
			    ISBLANK(_total) || _total = 0, "Not enough real usage yet to compare value against cost",
			    ISBLANK(_ahead) || _ahead = 0, "No users are yet generating more value than their contracted cost",
			    _ahead = _total, "All " & FORMAT(_total, "#,0") & " active users are generating more value than their contracted cost",
			    FORMAT(_ahead, "#,0") & " of " & FORMAT(_total, "#,0") & " active users are generating more value than their contracted cost")
		lineageTag: d1e32e3f-1b22-4046-9f60-73b4948fc28b

	/// Evidence line citing the real $ split behind 'VS Finding'.
	measure 'VS Evidence' =
			"Value ahead of spend: $" & FORMAT([VS Value Ahead $], "#,0.00") & " in value on $" &
			FORMAT([VS Cost Ahead $], "#,0.00") & " of cost (" & FORMAT([VS Ratio Ahead], "0.0") & "x); " &
			"total across all users: $" & FORMAT([Estimated Value $], "#,0.00") & " value on $" & FORMAT([Contracted Cost], "#,0.00") & " cost"
		lineageTag: fffff0b2-9bdf-4997-aca1-50428fa93ac1

	/// Implication -- highlights how concentrated the value-ahead-of-spend return is, computed
	/// dynamically (share of total value vs. share of total cost) rather than naming a specific user.
	measure 'VS Implication' =
			VAR _valShare = DIVIDE([VS Value Ahead $], [Estimated Value $])
			VAR _costShare = DIVIDE([VS Cost Ahead $], [Contracted Cost])
			RETURN
			IF(ISBLANK(_valShare), "Value and cost data are still too limited to size the return",
			    "That group drives " & FORMAT(_valShare, "0.0%") & " of all value from just " & FORMAT(_costShare, "0.0%") & " of all contracted cost")
		lineageTag: 0ff10045-4a2e-4a5e-ab49-c79d890cb0a7

	/// Recommended next action, arrow-prefixed per the 92d_action_maturity 'am_action' card convention.
	measure 'VS Action' = "→ Study what the value-ahead-of-spend users are doing differently and help the rest of the population adopt it"
		lineageTag: 61f5639e-bfc3-4303-a857-e167dec70e86

	/// Page subtitle string for 92f_value_vs_cost, same two-sentence pattern as 'Exec Page Answer'.
	measure 'VS Page Answer' = [VS Finding] & ". " & [VS Implication]
		lineageTag: 44a9280c-3a6c-4a47-a207-1054ae5f37b3

	/// Minutes-denominated form of Autonomous Hours used by the delegation ratio.
	measure 'Autonomous Minutes' = [Autonomous Hours] * 60
		formatString: #,0
		lineageTag: 505d006a-6ee4-4a42-92b7-ebf91bc8070d

	measure 'Assisted Minutes' = [Assisted Hours] * 60
		formatString: #,0
		lineageTag: fdaa86b8-0d1e-48c8-bcdf-ed19122d39be

	/// Ratio of modeled benchmark minutes saved to observed thread elapsed minutes; the numerator and denominator are intentionally different evidence types.
	measure 'Modeled-to-Elapsed Minutes Ratio' = DIVIDE([Assisted Minutes], [Autonomous Minutes])
		formatString: 0.0"x"
		lineageTag: 7202dd84-75fb-4af7-ba5a-2492010382f4

	measure 'User Delegation Rung' =
			VAR _tasks = [Cowork Tasks (Threads)]
			VAR _scheduled = [Reported Scheduled]
			VAR _multiSkill = [Multi-Skill Task %]
			VAR _duration = [Avg Task Duration (min)]
			RETURN
			    SWITCH(
			        TRUE(),
			        COALESCE(_tasks, 0) = 0, "Not started",
			        _scheduled > 0, "Automating",
			        _multiSkill >= 0.30, "Delegating",
			        _duration >= 5, "Using",
			        "Trying"
			    )
		lineageTag: 98e3f117-d463-4243-a722-5b9b9e62543c

	measure 'Users on Rung 3+' =
			COUNTROWS(
			    FILTER(
			        VALUES(Dim_User[UserKey]),
			        VAR _tasks = [Cowork Tasks (Threads)]
			        VAR _scheduled = [Reported Scheduled]
			        VAR _multiSkill = [Multi-Skill Task %]
			        RETURN
			            COALESCE(_tasks, 0) > 0 &&
			            (_scheduled > 0 || _multiSkill >= 0.30)
			    )
			)
		formatString: #,0
		lineageTag: 29773174-b04a-45ae-b3fe-af8b84937c8a

	measure 'Delegation Ladder Index' =
			DIVIDE(
			    SUMX(
			        VALUES(Dim_User[UserKey]),
			        SWITCH(
			            [User Delegation Rung],
			            "Automating", 4,
			            "Delegating", 3,
			            "Using", 2,
			            "Trying", 1,
			            0
			        )
			    ),
			    [Cowork Active Users] * 4
			)
		formatString: 0%
		lineageTag: e67e5f26-9744-4210-94a2-35a78a6f6682

	measure 'Users at Rung 1 (Trying)' =
			CALCULATE(
			    [Cowork Active Users],
			    FILTER(VALUES(Dim_User[UserKey]), [User Delegation Rung] = "Trying")
			)
		formatString: #,0
		lineageTag: 224726fe-9edc-4e99-a798-c3a1acb68119

	measure 'Users at Rung 2 (Using)' =
			CALCULATE(
			    [Cowork Active Users],
			    FILTER(VALUES(Dim_User[UserKey]), [User Delegation Rung] = "Using")
			)
		formatString: #,0
		lineageTag: 487d63a2-9a51-4fa4-9f71-891b8912cc65

	measure 'Users at Rung 3 (Delegating)' =
			CALCULATE(
			    [Cowork Active Users],
			    FILTER(VALUES(Dim_User[UserKey]), [User Delegation Rung] = "Delegating")
			)
		formatString: #,0
		lineageTag: 80bf76c1-34c5-4f8c-a4be-52c54acc9402

	measure 'Users at Rung 4 (Automating)' =
			CALCULATE(
			    [Cowork Active Users],
			    FILTER(VALUES(Dim_User[UserKey]), [User Delegation Rung] = "Automating")
			)
		formatString: #,0
		lineageTag: fcfc1a05-6e82-413c-9c8e-e53037873c25

	/// Dynamic conclusion for the delegation-ladder chart.
	measure 'Ladder Title' =
			VAR _stuck = DIVIDE([Users at Rung 1 (Trying)] + [Users at Rung 2 (Using)], [Cowork Active Users])
			VAR _auto = DIVIDE([Users at Rung 4 (Automating)], [Cowork Active Users])
			RETURN
			SWITCH(
			    TRUE(),
			    _auto >= 0.20, FORMAT(_auto, "0%") & " of users now automate work with Cowork",
			    _stuck >= 0.70, FORMAT(_stuck, "0%") & " of users never get past basic use",
			    _stuck >= 0.50, "Delegation is deepening, but half your users are still exploring",
			    "Delegation maturity is healthy across the population"
			)
		lineageTag: bf80c679-29ff-42a6-9161-035372592a31

	/// Subtitle composed from observed multi-step share and delegation-rung counts.
	measure 'Page 4 Subtitle' = FORMAT([Multi-Skill Task %], "0%") & " of tasks are multi-step. " & [Ladder Title]
		lineageTag: 056771a4-4bf2-43e9-ac3a-c0843f844a1c

	measure 'Review Targets Subtitle' =
			VAR _users = [Cowork Active Users]
			VAR _credits = [Total Credits Used]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_users) || _users = 0,
			        "No Cowork activity in the current view - widen the date range or clear a filter.",
			    ISBLANK(_credits),
			        "Billing data is not connected, so cost-risk flags remain off. Prioritize enablement using measured task volume and delegation depth across " & FORMAT(_users, "#,0") & " active users.",
			    _users < 20,
			        FORMAT(_users, "#,0") & " active users is below the 20-user percentile gate. Use absolute value and cost evidence; do not treat this as a license-removal list.",
			    FORMAT([Users Spend Ahead], "#,0") & " users are spend ahead of value. Start with the highest credits at risk, then validate context before any right-sizing decision."
			)
		lineageTag: 5e4278dc-0b90-4fb1-9ec8-8fbd9f50f1f0

	/// Suppresses the model's artificial blank relationship member while exposing the measured
	/// per-user delegation stage in the review list.
	measure 'Review Delegation Stage' =
			VAR _user = SELECTEDVALUE(Dim_User[DisplayName])
			RETURN IF(ISBLANK(_user), BLANK(), [User Delegation Rung])
		lineageTag: 7a87cf4a-b19c-4e91-8cf5-6f5a5718dce1

	/// Per-user enablement action for 99_review_targets. The rules use measured activity and
	/// delegation depth only; they intentionally do not infer license-removal or cost-risk decisions.
	measure 'Review Next Action' =
			VAR _user = SELECTEDVALUE(Dim_User[DisplayName])
			VAR _tasks = [Cowork Tasks (Threads)]
			VAR _stage = [User Delegation Rung]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_user), BLANK(),
			    ISBLANK(_tasks) || _tasks = 0, "Re-engage - no measured tasks in view",
			    LEFT(_stage, 1) = "1", "Coach - move from basic use to multi-step delegation",
			    LEFT(_stage, 1) = "2", "Expand - add specialized skills and repeatable workflows",
			    LEFT(_stage, 1) = "3", "Scale - share this delegation pattern with peers",
			    LEFT(_stage, 1) = "4", "Govern - review scheduled work and controls",
			    "Review measured activity"
			)
		lineageTag: 0e32de61-f92e-4d40-9ac9-52ff3dd12051

	/// Champion tier selected in the disconnected page control; defaults to Top 10%.
	measure 'Champion Tier Selected' = SELECTEDVALUE('Champion Tier'[Champion Tier], "Top 10%")
		displayFolder: Champions
		lineageTag: b6287872-cd46-441d-a33a-6edbda6afbdd

	/// Selected share of the eligible population that qualifies as potential champions.
	measure 'Champion Percent Selected' = DIVIDE(SELECTEDVALUE('Champion Tier'[Top Percent], 10), 100)
		formatString: 0%
		displayFolder: Champions
		lineageTag: 4ad9c543-aa42-4b4f-a8a5-a10ee6ee1566

	/// Current category scope used by the visible category lens.
	measure 'Champion Category Label' =
			VAR _categoryCount = COUNTROWS(VALUES(Dim_TaskCategory[Category]))
			RETURN
				SWITCH(
					TRUE(),
					NOT ISCROSSFILTERED(Dim_TaskCategory[Category]), "All work categories",
					_categoryCount = 1, SELECTEDVALUE(Dim_TaskCategory[Category]),
					FORMAT(_categoryCount, "#,0") & " selected categories"
				)
		displayFolder: Champions
		lineageTag: 320ce40a-7437-481f-a165-e591c4487eda

	/// Observed task count in the current user, date, organization, and category context.
	measure 'Champion Category Tasks' = [Cowork Tasks (Threads)]
		formatString: #,0
		displayFolder: Champions
		lineageTag: 1770f335-0e17-44e2-8458-6e4646373168

	/// Category tile label; categories with no activity return blank and are disabled in the slicer.
	measure 'Champion Category Task Label' = IF([Champion Category Tasks] > 0, FORMAT([Champion Category Tasks], "#,0"))
		displayFolder: Champions
		lineageTag: 3e5fbb78-9152-48e2-8096-8df2bd544052

	/// Users with at least one observed task in the current category and filter scope.
	measure 'Category User Count' =
			COUNTROWS(
				FILTER(
					VALUES(Dim_User[UserKey]),
					CALCULATE([Champion Category Tasks]) > 0
				)
			)
		formatString: #,0
		displayFolder: Category users
