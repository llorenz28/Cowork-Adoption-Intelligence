		lineageTag: d827b11c-3207-48d6-acc1-b7ee92776c7a

	/// Sort value for the standardized delegation ladder.
	measure 'Delegation Rung Order' =
			SWITCH(
			    [User Delegation Rung],
			    "Automating", 4,
			    "Delegating", 3,
			    "Using", 2,
			    "Trying", 1,
			    0
			)
		formatString: 0
		lineageTag: f98f8ba3-8724-4527-aa2f-dabaaf0ed361

	/// Per-rung user counts for the delegation-ladder trend.
	measure 'Users at Rung 0 (Not started)' =
			CALCULATE(
			    COUNTROWS(VALUES(Dim_User[UserKey])),
			    FILTER(VALUES(Dim_User[UserKey]), [User Delegation Rung] = "Not started")
			)
		formatString: #,0
		lineageTag: cd1021d3-ff38-4514-aed0-3ec55cf252b3

	/// Latest observed Cowork activity date in the current organization and user context.
	measure 'User Last Activity' = MAX(Fact_CoworkUsage[LastActivityDate])
		formatString: mmm d, yyyy
		lineageTag: 7a424c59-668c-4795-8e9c-ead18921f8fb

	/// Share of Cowork tasks with a category signal beyond the honest no-signal fallback.
	measure 'Cowork Classified %' =
			DIVIDE(
			    CALCULATE([Cowork Task Count], Fact_CoworkDetail[CategorySignal] <> "No signal"),
			    [Cowork Task Count]
			)
		formatString: 0.0%
		lineageTag: 33f60b1e-9328-4baf-a810-0d11153cbbc0

	/// Share of Cowork tasks classified from an authored artifact under the strict Cowork path.
	measure 'Cowork Observed-Evidence %' =
			DIVIDE(
			    CALCULATE([Cowork Task Count], Fact_CoworkDetail[MappingConfidence] = "Observed"),
			    [Cowork Task Count]
			)
		formatString: 0.0%
		lineageTag: 6ca89fe2-1e9d-49a9-aded-2272fec8fd74

	/// Share of Cowork tasks whose selected skill has a curated friendly name.
	measure 'Cowork Friendly-Named %' =
			DIVIDE(
			    CALCULATE([Cowork Task Count], Fact_CoworkDetail[MappingConfidence] <> "None"),
			    [Cowork Task Count]
			)
		formatString: 0.0%
		lineageTag: 287d0fcd-1d98-44a2-b0f4-09bfd18f8639

	/// Latest-week cohort count for the scorecard, directly comparable with Cowork Weekly Active Users.
	measure 'Cowork Weekly Users on Rung 3+' =
			VAR _currentWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Aggregate Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			RETURN
			    CALCULATE(
			        [Users on Rung 3+],
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _currentWeek
			    )
		formatString: #,0
		lineageTag: 6d962941-6e43-49b4-b9d8-6c11a310340a

	/// Latest-week delegation index for the scorecard's active-user cohort.
	measure 'Cowork Weekly Delegation Ladder Index' =
			VAR _currentWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Aggregate Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			RETURN
			    CALCULATE(
			        [Delegation Ladder Index],
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _currentWeek
			    )
		formatString: 0%
		lineageTag: c74a48a2-6d3f-45fa-b0b3-c0a67d5b6dc2

	/// Latest-week trying cohort, directly comparable with the scorecard's weekly active users.
	measure 'Cowork Weekly Users at Rung 1 (Trying)' =
			COALESCE(
			VAR _currentWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Aggregate Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			RETURN
			    CALCULATE(
			        [Users at Rung 1 (Trying)],
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _currentWeek
			    ),
			0
			)
		formatString: #,0
		lineageTag: 2a1a351f-49ea-48cb-846b-3a0d7dbb4781

	/// Latest-week using cohort, directly comparable with the scorecard's weekly active users.
	measure 'Cowork Weekly Users at Rung 2 (Using)' =
			COALESCE(
			VAR _currentWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Aggregate Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			RETURN
			    CALCULATE(
			        [Users at Rung 2 (Using)],
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _currentWeek
			    ),
			0
			)
		formatString: #,0
		lineageTag: 8ef7c164-3f2c-4c48-a94b-36cd4e1298ad

	/// Category-selector label that preserves categories with zero observed tasks.
	measure 'Category Selector Task Label' = FORMAT(COALESCE([Total Tasks], 0), "#,0")
		displayFolder: Category users
		lineageTag: 561c0761-a47a-46f8-8b33-4d8ee24158bd

	/// Average categorized tasks per user in the current filter context.
	measure 'Tasks per User' = DIVIDE([Total Tasks], [Task Users])
		formatString: #,0.0
		lineageTag: 4c6fd08a-962e-47a7-a90d-0c175e2359f4

	/// Observed task share by category within the current external filter context.
	measure 'Observed Task Share %' =
			DIVIDE(
				[Total Tasks],
				CALCULATE(
					[Total Tasks],
					ALLSELECTED(Dim_TaskCategory[Category])
				)
			)
		formatString: 0.0%
		lineageTag: e4d297a6-f25d-45c2-b96e-b6ec5ee4835d

	/// Modeled capacity share by category within the current external filter context.
	measure 'Modeled Capacity Share %' =
			DIVIDE(
				[Assisted Hours],
				CALCULATE(
					[Assisted Hours],
					ALLSELECTED(Dim_TaskCategory[Category])
				)
			)
		formatString: 0.0%
		lineageTag: 4c06c81a-49b5-44a2-a018-0b5f011eaca1

	/// Highest-volume observed task category for the current department and filters.
	measure 'Department Highest Category' =
			VAR _categories =
				FILTER(
					ADDCOLUMNS(
						ALLSELECTED(Dim_TaskCategory[Category]),
						"__Tasks", CALCULATE([Total Tasks])
					),
					[__Tasks] > 0
				)
			VAR _topCategory =
				TOPN(
					1,
					_categories,
					[__Tasks], DESC,
					Dim_TaskCategory[Category], ASC
				)
			RETURN
				CONCATENATEX(_topCategory, Dim_TaskCategory[Category], "")
		formatString: General
		lineageTag: 46f61ab5-2bb0-4f68-83fd-a5e5be1c8882

	/// Selected assisted-time assumption for category-task rows that have observed tasks; suppresses empty category-task combinations in the detail matrix.
	measure 'Task Selected Minutes' = IF(ISBLANK([Total Tasks]), BLANK(), [Assisted Minutes Selected])
		formatString: #,0
		displayFolder: Demand & capacity
		lineageTag: 13926a77-611f-4bf8-b6ad-e3f7d55fc494

	/// Classification label for the category-task matrix. Category/task rows show the single value or Multiple (n); the grand total shows the distinct classification count.
	measure 'Task Classification Display' =
			VAR _values = FILTER(VALUES(Fact_Tasks[TaskClassification]), NOT ISBLANK(Fact_Tasks[TaskClassification]))
			VAR _count = COUNTROWS(_values)
			RETURN
			    SWITCH(
			        TRUE(),
			        _count = 0, BLANK(),
			        NOT ISINSCOPE(Dim_TaskCategory[Category]), FORMAT(_count, "0") & " classifications",
			        _count = 1, MAXX(_values, Fact_Tasks[TaskClassification]),
			        "Multiple (" & FORMAT(_count, "0") & ")"
			    )
		formatString: General
		displayFolder: Demand & capacity
		lineageTag: 9bdd5d07-47d7-4524-913c-74ff6e9e053a

	/// Friendly primary-tool label for the category-task matrix. Category/task rows show the single value or Multiple (n); the grand total shows the distinct tool count.
	measure 'Primary Tool Display' =
			VAR _values = FILTER(VALUES(Fact_Tasks[Primary Tool]), NOT ISBLANK(Fact_Tasks[Primary Tool]))
			VAR _count = COUNTROWS(_values)
			RETURN
			    SWITCH(
			        TRUE(),
			        _count = 0, BLANK(),
			        NOT ISINSCOPE(Dim_TaskCategory[Category]), FORMAT(_count, "0") & " tools",
			        _count = 1, MAXX(_values, Fact_Tasks[Primary Tool]),
			        "Multiple (" & FORMAT(_count, "0") & ")"
			    )
		formatString: General
		displayFolder: Demand & capacity
		lineageTag: 023f274e-eb97-46a6-9040-94bcaab775f1

	/// Purview model label for the category-task matrix. Category/task rows show the single value or Multiple (n); the grand total shows the distinct model count.
	measure 'Copilot Model Display' =
			VAR _values = FILTER(VALUES(Fact_Tasks[Model]), NOT ISBLANK(Fact_Tasks[Model]))
			VAR _count = COUNTROWS(_values)
			RETURN
			    SWITCH(
			        TRUE(),
			        _count = 0, BLANK(),
			        NOT ISINSCOPE(Dim_TaskCategory[Category]), FORMAT(_count, "0") & " models",
			        _count = 1, MAXX(_values, Fact_Tasks[Model]),
			        "Multiple (" & FORMAT(_count, "0") & ")"
			    )
		formatString: General
		displayFolder: Demand & capacity
		lineageTag: 3c2ccdec-6134-4a21-b8fd-18e4fb5d1b42

	/// Default benchmark citation for category-task rows with observed tasks; suppresses empty hierarchy combinations.
	measure 'Task Default Evidence' = IF(ISBLANK([Total Tasks]), BLANK(), SELECTEDVALUE(Dim_TaskCategory[PrimarySource]))
		formatString: General
		displayFolder: Demand & capacity
		lineageTag: b557947c-efa1-478e-bc22-8d1d07c7b73f

	/// Benchmark source URL for category-task rows with observed tasks; suppresses empty hierarchy combinations.
	measure 'Task Source Link' = IF(ISBLANK([Total Tasks]), BLANK(), SELECTEDVALUE(Dim_TaskCategory[SourceURL]))
		formatString: General
		displayFolder: Demand & capacity
		lineageTag: 767b7d21-7d47-4785-9c25-eb1da3a996b9
		dataCategory: WebUrl

	column Value
		dataType: string
		isHidden
		lineageTag: a35b7854-64af-4ee0-94ce-3d9f6cb0a930
		summarizeBy: none
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {BLANK()}
