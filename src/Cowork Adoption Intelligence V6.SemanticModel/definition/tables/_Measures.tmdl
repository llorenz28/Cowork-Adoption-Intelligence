		formatString: #,0.0
		displayFolder: Champions
		lineageTag: 88063e61-94de-4a4c-92c4-8b5242e415c4

	/// Departments in scope with at least one qualifying potential champion.
	measure 'Departments with Champions' =
			VAR _visibleUsers = VALUES(Dim_User[UserKey])
			VAR _baseStats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						Dim_User[Department],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate]),
						"__MultiSkillTasks",
							CALCULATE(
								COUNTROWS(Fact_CoworkThread),
								Fact_CoworkThread[PluginCount] > 1
							),
						"__Duration", AVERAGE(Fact_CoworkThread[DurationMin])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _stats =
				ADDCOLUMNS(
					_baseStats,
					"__Delegation",
						VAR _tasks = [__Tasks]
						VAR _userKey = Dim_User[UserKey]
						VAR _scheduled =
							CALCULATE(
								[Reported Scheduled],
								REMOVEFILTERS(Dim_User),
								TREATAS({_userKey}, Dim_User[UserKey])
							)
						VAR _multiSkill = DIVIDE([__MultiSkillTasks], _tasks)
						VAR _duration = [__Duration]
						RETURN
							SWITCH(
								TRUE(),
								_scheduled > 0, 1,
								_multiSkill >= 0.30, 0.75,
								_duration >= 5, 0.5,
								0.25
							)
				)
			VAR _population = FILTER(_stats, [__Tasks] >= 3 && [__Weeks] >= 2)
			VAR _populationCount = COUNTROWS(_population)
			VAR _withPercentiles =
				ADDCOLUMNS(
					_population,
					"__ActivityPercentile",
						VAR _tasks = [__Tasks]
						VAR _rank = RANKX(_population, [__Tasks], _tasks, DESC, SKIP)
						RETURN IF(_populationCount <= 1, 1, DIVIDE(_populationCount - _rank, _populationCount - 1)),
					"__ConsistencyPercentile",
						VAR _weeks = [__Weeks]
						VAR _rank = RANKX(_population, [__Weeks], _weeks, DESC, SKIP)
						RETURN IF(_populationCount <= 1, 1, DIVIDE(_populationCount - _rank, _populationCount - 1))
				)
			VAR _scored =
				ADDCOLUMNS(
					_withPercentiles,
					"__Score",
						100 * (
							0.40 * [__ActivityPercentile] +
							0.35 * [__ConsistencyPercentile] +
							0.25 * [__Delegation]
						)
				)
			VAR _ranked =
				ADDCOLUMNS(
					_scored,
					"__Rank",
						VAR _rankValue = [__Score] * 1000000 - Dim_User[UserKey]
						RETURN RANKX(_scored, [__Score] * 1000000 - Dim_User[UserKey], _rankValue, DESC, DENSE)
				)
			VAR _cutoff =
				IF(
					_populationCount > 0,
					MIN(_populationCount, MAX(1, CEILING(_populationCount * [Champion Percent Selected], 1)))
				)
			VAR _candidateDepartments =
				SUMMARIZE(
					FILTER(
						_ranked,
						[__Rank] <= _cutoff &&
						Dim_User[UserKey] IN _visibleUsers &&
						NOT ISBLANK(Dim_User[Department])
					),
					Dim_User[Department]
				)
			RETURN COUNTROWS(_candidateDepartments)
		formatString: #,0
		displayFolder: Champions
		lineageTag: e2afaeb5-b8ed-495f-8108-f46d9c7e097f

	/// Departments in scope with at least one user meeting the minimum evidence floor.
	measure 'Departments with Eligible Users' =
			VAR _visibleUsers = VALUES(Dim_User[UserKey])
			VAR _stats =
				CALCULATETABLE(
					SUMMARIZE(
						Fact_CoworkThread,
						Dim_User[UserKey],
						Dim_User[Department],
						"__Tasks", COUNTROWS(Fact_CoworkThread),
						"__Weeks", DISTINCTCOUNT(Fact_CoworkThread[WeekStartDate])
					),
					REMOVEFILTERS(Dim_User)
				)
			VAR _eligibleDepartments =
				SUMMARIZE(
					FILTER(
						_stats,
						[__Tasks] >= 3 &&
						[__Weeks] >= 2 &&
						Dim_User[UserKey] IN _visibleUsers &&
						NOT ISBLANK(Dim_User[Department])
					),
					Dim_User[Department]
				)
			RETURN COUNTROWS(_eligibleDepartments)
		formatString: #,0
		displayFolder: Champions
		lineageTag: 6d22122e-329c-4259-9da2-9837bf5b57ae

	/// Share of eligible departments with one or more potential champions.
	measure 'Champion Department Coverage %' =
			DIVIDE(
				[Departments with Champions],
