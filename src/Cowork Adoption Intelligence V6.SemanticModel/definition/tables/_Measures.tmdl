	/// Dynamic summary of the selected category scope and its observed user footprint.
	measure 'Champion Page Subtitle' =
			[Champion Category Label] & ": " &
			FORMAT([Champion Category Tasks], "#,0") & " observed tasks across " &
			FORMAT([Category User Count], "#,0") & " users in " &
			FORMAT([Category Department Count], "#,0") & " departments."
		displayFolder: Champions
		lineageTag: e3435f69-03a7-4843-b50b-3c582d805d1f

	/// Action-oriented interpretation for the category-user heatmap.
	measure 'Champion Enablement Guidance' =
			VAR _users = [Category User Count]
			VAR _tasks = [Champion Category Tasks]
			VAR _avgTasks = [Category Average Tasks per User]
			RETURN
				SWITCH(
					TRUE(),
					_users = 0,
						"No users in this scope. Widen the date range or clear filters.",
					_users = 1,
						"One user accounts for all " & FORMAT(_tasks, "#,0") & " tasks. Confirm role context before scaling.",
					_avgTasks < 2,
						"Usage is broad but shallow. Build repeat practice before identifying peer partners.",
					"Use darker cells to find sustained experience. Confirm role fit and willingness before outreach."
				)
		displayFolder: Champions
		lineageTag: fbf52e9e-9cc9-44aa-84cb-c804faf7392e

	measure 'Cowork Delegation Not Started Users' =
			IF(
			    ISBLANK([Cowork Active Users]),
			    BLANK(),
			    COUNTROWS(
			        FILTER(
			            VALUES(Dim_User[UserKey]),
			            [User Delegation Rung] = "Not started"
			        )
			    )
			)
		formatString: #,0
		lineageTag: f3e6bdf4-7961-4cd4-ba53-f85f002b802d

	measure 'Cowork Delegation Trying Users' =
			COUNTROWS(
			    FILTER(
			        VALUES(Dim_User[UserKey]),
			        [User Delegation Rung] = "Trying"
			    )
			)
		formatString: #,0
		lineageTag: d9fc206e-e60f-4f24-9ad2-550c8dcbc29c

	measure 'Cowork Delegation Using Users' =
