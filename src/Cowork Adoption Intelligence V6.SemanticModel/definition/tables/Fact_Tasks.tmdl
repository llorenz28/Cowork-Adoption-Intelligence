	column 'Work Timing' =
			LOOKUPVALUE(
				Fact_CoworkThread[Work Timing],
				Fact_CoworkThread[ThreadId], Fact_Tasks[ThreadId]
			)
		dataType: string
		lineageTag: fc2ca6eb-63d6-4017-8b06-a4926fa7f18a
		summarizeBy: none

	/// Customer-facing product or application inferred from observed resource
	/// MIME evidence first, then the existing friendly skill classification.
	column 'Primary Tool' =
			VAR _threadId = Fact_Tasks[ThreadId]
			VAR _resourceType =
				MAXX(
					TOPN(
						1,
						FILTER(
							ALL(Bridge_CoworkResource),
							Bridge_CoworkResource[ThreadId] = _threadId &&
							NOT ISBLANK(Bridge_CoworkResource[ResType])
						),
						SWITCH(
							TRUE(),
							CONTAINSSTRING(LOWER(Bridge_CoworkResource[ResType]), "pdf"), 1,
							CONTAINSSTRING(LOWER(Bridge_CoworkResource[ResType]), "wordprocessingml"), 2,
							CONTAINSSTRING(LOWER(Bridge_CoworkResource[ResType]), "presentationml"), 3,
							CONTAINSSTRING(LOWER(Bridge_CoworkResource[ResType]), "spreadsheetml"), 4,
							CONTAINSSTRING(LOWER(Bridge_CoworkResource[ResType]), "image/"), 5,
							99
						), ASC,
						Bridge_CoworkResource[ResType], ASC
					),
					Bridge_CoworkResource[ResType]
				)
			VAR _resource = LOWER(COALESCE(_resourceType, ""))
			VAR _friendly = Fact_Tasks[PrimarySkillDisplayName]
			RETURN
				SWITCH(
					TRUE(),
					CONTAINSSTRING(_resource, "pdf"), "PDF",
					CONTAINSSTRING(_resource, "wordprocessingml"), "Word",
					CONTAINSSTRING(_resource, "presentationml"), "PowerPoint",
					CONTAINSSTRING(_resource, "spreadsheetml"), "Excel",
					CONTAINSSTRING(_resource, "image/"), "Image",
					_friendly IN {"Draft Email", "Review Inbox", "Read Email", "Send Email"}, "Outlook",
					_friendly IN {"Check Calendar", "Schedule Meeting"}, "Calendar",
					_friendly = "Build Slides", "PowerPoint",
					_friendly IN {"Create Document", "Save Document", "Write File", "Edit Document", "Edit File"}, "Word",
					CONTAINSSTRING(_friendly, "Confluence"), "Confluence",
					_friendly = "Search Jira & Confluence", "Jira / Confluence",
					_friendly = "Microsoft 365 Search", "Microsoft 365 Search",
					_friendly = "Directory Lookup", "Microsoft Graph",
					_friendly = "Run Script", "Code",
					_friendly = "Publish File", "SharePoint / OneDrive",
					_friendly = "Plan & Track Work", "Tasks",
					_friendly = "Scheduled Work", "Scheduled task",
					_friendly = "General request", "Cowork",
					_friendly = "Read File Content", "File",
					_friendly = "Power BI Analysis", "Power BI",
					COALESCE(_friendly, "Other")
				)
		dataType: string
		lineageTag: 3e8741d0-7e23-401c-a9c6-b0b44d2c7f89
		summarizeBy: none

	partition Fact_Tasks = calculated
		mode: import
		source =
				SUMMARIZE(
					FILTER(
						Staging_ModelData,
						Staging_ModelData[_Entity] = "Fact_Tasks"
					),
					Staging_ModelData[_RowId],
					Staging_ModelData[ThreadId],
					Staging_ModelData[UserKey],
					Staging_ModelData[CategoryKey],
					Staging_ModelData[DateKey],
					Staging_ModelData[Tasks],
					Staging_ModelData[Model],
					Staging_ModelData[PrimaryBusinessTool],
					Staging_ModelData[PrimarySkillDisplayName],
					Staging_ModelData[BusinessBehavior],
					Staging_ModelData[TaskClassification],
					Staging_ModelData[LowMin],
					Staging_ModelData[MidMin],
					Staging_ModelData[HighMin]
				)

	annotation PBI_ResultType = Exception
