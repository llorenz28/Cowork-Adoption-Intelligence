		dataType: string
		lineageTag: 48228063-9e9c-4f4c-b875-ab55cbc2f6a8
		sourceColumn: MappingConfidence

	/// Curated, human-readable label for each real observed plugin name (Cowork v3 remediation:
	/// "make skill names user-friendly"). Dim_CoworkSkill's SkillDisplayName prefers this value,
	/// falling back to the raw PluginName for any future plugin not yet curated here -- same
	/// honest null-safe fallback convention already used for Category/CategoryKey, so an
	/// uncurated name is visible (as its raw form) instead of blank.
	column FriendlyName
		dataType: string
		lineageTag: 98250375-f002-455a-84f9-89b64df5c525
		sourceColumn: FriendlyName

	/// Business identifies evidence of customer work, Orchestration identifies
	/// agent execution mechanics, and Unclassified preserves new tools for review.
	column ToolRole
		dataType: string
		lineageTag: 189dcd69-ea94-4ef2-9c02-8eb5636ce91b
		sourceColumn: ToolRole

	/// Specific business behavior used for task-grain value attribution.
	/// Blank for orchestration and unclassified tools.
	column BusinessBehavior
		dataType: string
		lineageTag: 664a69d4-b45d-44e8-8b97-fe7fa875006a
		sourceColumn: BusinessBehavior

	/// Higher values win when a task contains multiple business tools. Outcome
	/// actions outrank supporting searches and lookups.
	column AttributionPriority
		dataType: int64
		isHidden
		lineageTag: ee1053be-1b5f-497d-afe2-1de88cadf2a8
		summarizeBy: none
		sourceColumn: AttributionPriority

