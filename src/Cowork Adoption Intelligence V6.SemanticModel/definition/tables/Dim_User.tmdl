	hierarchy 'Org Drilldown'
		lineageTag: 5e1d15b3-72da-4c8a-ac93-ba560a138b4d

		level 'Business Unit'
			lineageTag: ed1416f2-7dc5-4f1e-b7ff-6170f5ebad39
			column: BusinessUnit

		level Department
			lineageTag: fa35a941-46fd-42ba-9fa5-45710572c08d
			column: Department

		level Manager
			lineageTag: d6050f72-0d86-4aac-8258-6fff3f5fe839
			column: Manager

	partition Dim_User = calculated
		mode: import
		source =
				SUMMARIZE(
					FILTER(
						Staging_ModelData,
						Staging_ModelData[_Entity] = "Dim_User"
					),
					Staging_ModelData[_RowId],
					Staging_ModelData[UserKey],
					Staging_ModelData[UserPrincipalName],
					Staging_ModelData[DisplayName],
					Staging_ModelData[UserID],
					Staging_ModelData[CopilotLicense],
					Staging_ModelData[LicenseSKU],
					Staging_ModelData[IdentityDataQuality],
					Staging_ModelData[DemographicDataQuality]
				)

	annotation PBI_ResultType = Exception
