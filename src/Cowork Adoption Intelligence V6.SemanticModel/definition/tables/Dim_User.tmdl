	column 'Lifetime Value $' = CALCULATE([Estimated Value $])
		dataType: double
		isHidden
		formatString: \$#,0
		lineageTag: a017f734-4645-4191-937e-1efae8b80590
		summarizeBy: none

	column 'Value Percentile' =
			VAR n = COUNTROWS(FILTER(ALL(Dim_User), NOT ISBLANK(Dim_User[UserKey]))) /* Exclude Power BI's auto-added blank relationship member. */
			VAR MinPopulationForPercentile = 20 /* Suppress unstable percentile ranks below 20 users. */
			VAR r = RANKX(ALL(Dim_User), Dim_User[Lifetime Value $], , DESC)
			RETURN IF(n < MinPopulationForPercentile, BLANK(), DIVIDE(n - r, n - 1))
		dataType: double
		isHidden
		formatString: 0.0%
		lineageTag: 438ec33f-5b22-4334-8d13-ead4b08cf6f0
		summarizeBy: none

	column 'Value Band' =
			VAR n = COUNTROWS(FILTER(ALL(Dim_User), NOT ISBLANK(Dim_User[UserKey]))) /* Exclude Power BI's auto-added blank relationship member. */
			VAR MinPopulationForPercentile = 20 /* Suppress unstable percentile ranks below 20 users. */
			VAR p = Dim_User[Value Percentile]
			RETURN SWITCH(TRUE(), n < MinPopulationForPercentile, "Insufficient sample (n=" & n & ")", p >= 0.90, "Top 10%", p >= 0.75, "10-25%", p >= 0.50, "25-50%", p >= 0.25, "50-75%", "Bottom 25%")
		dataType: string
		lineageTag: 11aeb5be-94ad-43dd-b381-f2c137fdd3b0
		summarizeBy: none
		sortByColumn: 'Value Band Order'

	column 'Value Band Order' =
			VAR n = COUNTROWS(FILTER(ALL(Dim_User), NOT ISBLANK(Dim_User[UserKey]))) /* Exclude Power BI's auto-added blank relationship member. */
			VAR MinPopulationForPercentile = 20 /* Suppress unstable percentile ranks below 20 users. */
			VAR p = Dim_User[Value Percentile]
			RETURN SWITCH(TRUE(), n < MinPopulationForPercentile, 0, p >= 0.90, 1, p >= 0.75, 2, p >= 0.50, 3, p >= 0.25, 4, 5)
		dataType: int64
		isHidden
		lineageTag: 18062c56-bc1c-4e5d-9e36-86f6e6e62832
		summarizeBy: none

	column 'Credits Lifetime' = CALCULATE([Total Credits Used])
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: 4b338e4f-3b18-45ea-92a3-4d0897b93fd4
		summarizeBy: none

	column 'Credit Percentile' =
			VAR n = COUNTROWS(FILTER(ALL(Dim_User), NOT ISBLANK(Dim_User[UserKey]))) /* Exclude Power BI's auto-added blank relationship member. */
			VAR MinPopulationForPercentile = 20 /* Suppress unstable percentile ranks below 20 users. */
			VAR r = RANKX(ALL(Dim_User), Dim_User[Credits Lifetime], , DESC)
			RETURN IF(n < MinPopulationForPercentile, BLANK(), DIVIDE(n - r, n - 1))
		dataType: double
		isHidden
		formatString: 0.0%
		lineageTag: 4892a84b-0e22-4701-a467-7fcb558015d7
		summarizeBy: none

	column 'Credit Band' =
			VAR n = COUNTROWS(FILTER(ALL(Dim_User), NOT ISBLANK(Dim_User[UserKey]))) /* Exclude Power BI's auto-added blank relationship member. */
			VAR MinPopulationForPercentile = 20 /* Suppress unstable percentile ranks below 20 users. */
			VAR p = Dim_User[Credit Percentile]
			RETURN SWITCH(TRUE(), n < MinPopulationForPercentile, "Insufficient sample (n=" & n & ")", p >= 0.90, "Top 10%", p >= 0.75, "10-25%", p >= 0.50, "25-50%", p >= 0.25, "50-75%", "Bottom 25%")
		dataType: string
		lineageTag: 62da7cd2-a47f-4e94-8725-9c5cc2607309
		summarizeBy: none
		sortByColumn: 'Credit Band Order'

	column 'Credit Band Order' =
			VAR n = COUNTROWS(FILTER(ALL(Dim_User), NOT ISBLANK(Dim_User[UserKey]))) /* Exclude Power BI's auto-added blank relationship member. */
			VAR MinPopulationForPercentile = 20 /* Suppress unstable percentile ranks below 20 users. */
			VAR p = Dim_User[Credit Percentile]
			RETURN SWITCH(TRUE(), n < MinPopulationForPercentile, 0, p >= 0.90, 1, p >= 0.75, 2, p >= 0.50, 3, p >= 0.25, 4, 5)
		dataType: int64
		isHidden
		lineageTag: 2503e905-5593-4cb2-a2f3-c87687aeff3b
		summarizeBy: none

	column 'Value vs Credit' =
			VAR n = COUNTROWS(FILTER(ALL(Dim_User), NOT ISBLANK(Dim_User[UserKey]))) /* Exclude Power BI's auto-added blank relationship member. */
			VAR MinPopulationForPercentile = 20 /* Suppress unstable percentile ranks below 20 users. */
			VAR g = Dim_User[Value Percentile] - Dim_User[Credit Percentile]
			RETURN SWITCH(TRUE(), n < MinPopulationForPercentile, "Insufficient sample (n=" & n & ")", g >= 0.15, "Value ahead of spend", g <= -0.15, "Spend ahead of value", "Balanced")
		dataType: string
		lineageTag: e020b746-49a6-4cc8-9576-03e5d6c5ce5d
		summarizeBy: none
		sortByColumn: 'Value vs Credit Order'

	column 'Value vs Credit Order' =
			VAR n = COUNTROWS(FILTER(ALL(Dim_User), NOT ISBLANK(Dim_User[UserKey]))) /* Exclude Power BI's auto-added blank relationship member. */
			VAR MinPopulationForPercentile = 20 /* Suppress unstable percentile ranks below 20 users. */
			VAR g = Dim_User[Value Percentile] - Dim_User[Credit Percentile]
			RETURN SWITCH(TRUE(), n < MinPopulationForPercentile, 0, g >= 0.15, 1, g <= -0.15, 3, 2)
		dataType: int64
		isHidden
		lineageTag: 2f7b94c2-0436-4c9b-9405-27d60e54812d
		summarizeBy: none

