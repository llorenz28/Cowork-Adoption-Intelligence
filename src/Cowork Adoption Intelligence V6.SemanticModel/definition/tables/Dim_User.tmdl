	column Country = MAXX(RELATEDTABLE(Dim_UserOrg), Dim_UserOrg[Country])
		dataType: string
		lineageTag: 0df7c040-ef70-4c6d-b19f-497f38bd9838
		summarizeBy: none

	column Region =
			VAR c = Dim_User[Country]
			RETURN IF(ISBLANK(c), BLANK(), SWITCH(TRUE(), c = "US", "AMER", c = "IN", "APAC", c in {"IE", "GB", "DE", "FR"}, "EMEA", "Other"))
		dataType: string
		lineageTag: 402ff2f4-5808-4bfe-a136-23c3abbef302
		summarizeBy: none

	column IdentityDataQuality
		dataType: string
		lineageTag: de616c66-e1de-4f81-a39d-c17bc1ef75f7
		summarizeBy: none
		sourceColumn: Staging_ModelData[IdentityDataQuality]

	column DemographicDataQuality
		dataType: string
		lineageTag: 064f60e4-61aa-4cda-83d3-eee476333c0d
		summarizeBy: none
		sourceColumn: Staging_ModelData[DemographicDataQuality]

	column OrgDataQuality =
			VAR q = MAXX(RELATEDTABLE(Dim_UserOrg), Dim_UserOrg[DataQuality])
			RETURN IF(ISBLANK(q), "Not yet connected - no matching row in Dim_UserOrg (add a real Entra/HR organization export)", q)
		dataType: string
		lineageTag: ffe93323-b21a-4bf7-b5c6-0f8d6626d2bd
		summarizeBy: none

	/// Absolute per-user cost, parallel to 'Lifetime Value $' and 'Credits Lifetime'.
	column 'Contracted Cost Lifetime' = CALCULATE([Contracted Cost])
		dataType: double
		isHidden
		formatString: \$#,0
		lineageTag: affaff0e-fa8c-4c85-8700-c7fef894e236
		summarizeBy: none

	/// Absolute value-vs-cost comparison that remains usable below the percentile
	/// population threshold. Applies a +/-15% band to the lifetime value-to-cost ratio.
	column 'Value vs Cost Band' =
			VAR _value = Dim_User[Lifetime Value $]
			VAR _cost = Dim_User[Contracted Cost Lifetime]
			VAR _ratio = DIVIDE(_value, _cost)
			RETURN SWITCH(TRUE(), ISBLANK(_ratio), "Insufficient cost data", _ratio >= 1.15, "Value ahead of spend", _ratio <= 0.85, "Spend ahead of value", "Balanced")
		dataType: string
		lineageTag: 311f62a2-88d9-447e-8082-c5aa61ba4e4d
		summarizeBy: none
		sortByColumn: 'Value vs Cost Band Order'

	column 'Value vs Cost Band Order' =
			VAR _value = Dim_User[Lifetime Value $]
			VAR _cost = Dim_User[Contracted Cost Lifetime]
			VAR _ratio = DIVIDE(_value, _cost)
			RETURN SWITCH(TRUE(), ISBLANK(_ratio), 0, _ratio >= 1.15, 1, _ratio <= 0.85, 3, 2)
		dataType: int64
		isHidden
		lineageTag: a53e552a-08f8-43d0-93f5-38d8224713ff
		summarizeBy: none

	column _RowId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ed1e25d6-f050-464b-b190-98e937ebcfb9
