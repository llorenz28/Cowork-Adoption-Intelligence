table Fact_CoworkUsage
	lineageTag: eb4eb6e1-c5e3-4819-ab46-c404f0c0bb06

	measure 'Reported Tasks' = SUM(Fact_CoworkUsage[TotalTasks])
		formatString: #,0
		lineageTag: 39ca5535-1fbc-40ff-940b-6b52df3e85ed

	measure 'Reported Scheduled' = SUM(Fact_CoworkUsage[ScheduledTasks])
		formatString: #,0
		lineageTag: 8f2a61ff-e799-4b3f-9bab-68b575fa5094

	/// Reports whether optional scheduled-task data supports delegation rung 4 and the full ladder index range.
	measure 'Scheduled Data Health' =
			VAR _rows = COUNTROWS(ALL(Fact_CoworkUsage))
			VAR _sched = CALCULATE(SUM(Fact_CoworkUsage[ScheduledTasks]), ALL(Fact_CoworkUsage))
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_rows) || _rows = 0,
			            "Scheduled-task data not connected — rung 4 (Automating) cannot be reached and the ladder index is capped near 75.",
			        ISBLANK(_sched) || _sched = 0,
			            "Scheduled-task data connected but reports zero scheduled tasks — no user will reach rung 4.",
			        "Scheduled-task data connected."
			    )
		lineageTag: 15a243b7-0270-40cd-8a17-0f451666581d

	/// Discloses that the admin center export has lifetime user grain rather than date grain.
	measure 'Scheduled Data Grain Note' =
			IF(
				ISBLANK([Reported Tasks]),
				BLANK(),
				"Scheduled-task data is a per-user lifetime total from the admin center export. It does not vary with the date filter."
			)
		lineageTag: 4fbeca5c-b34b-4bc7-81bd-2e2e30171f98

	measure 'Reported User-Initiated' = SUM(Fact_CoworkUsage[UserInitiatedTasks])
		formatString: #,0
		lineageTag: 9086aa32-4a3b-4fb7-8460-3191ef06c1a5

	measure 'Scheduled Share %' = DIVIDE([Reported Scheduled], [Reported Tasks])
		formatString: 0.0%
		lineageTag: 37c45f69-44b7-4cf3-80bd-445f8ca885fc

	/// Reconciles Purview-derived thread count against a separately sourced admin-center Cowork usage export. Blank while Fact_CoworkUsage is using its Purview-derived fallback because that is not an independent comparison.
	measure 'Audit Coverage %' =
			VAR _hasIndependentUsageExport =
				COUNTROWS(
					FILTER(
						ALL(Fact_CoworkUsage),
						CONTAINSSTRING(Fact_CoworkUsage[DataQuality], "loaded from CoworkUsageCsvPath")
					)
				) > 0
			VAR _dateNarrowed =
				ISFILTERED(Dim_Date[Date]) ||
				ISFILTERED(Dim_Date[WeekStart]) ||
				ISFILTERED(Dim_Date[MonthStart]) ||
				ISFILTERED(Dim_Date[Year])
			RETURN
				IF(
					_hasIndependentUsageExport && NOT _dateNarrowed,
					DIVIDE([Cowork Tasks (Threads)], [Reported Tasks]),
					BLANK()
				)
		formatString: 0.0%
		lineageTag: 1e03d9c6-afca-4624-8d6a-369c86844f23

	/// Invocation-weighted share of technical tools classified as either business
	/// or orchestration. Unclassified tools remain visible for remediation.
	measure 'Skill Mapping Coverage %' = DIVIDE(CALCULATE([Skill Invocations], Dim_CoworkSkill[ToolRole] <> "Unclassified"), [Skill Invocations])
		formatString: 0.0%
		lineageTag: 5cd43138-844b-4f16-b957-04304bfb261c

	column UserPrincipalName
		dataType: string
		lineageTag: 19869983-5b19-49d5-aea3-9ce8d8694968
		summarizeBy: none
		sourceColumn: Staging_ModelData[UserPrincipalName]

	column DisplayName
		dataType: string
		lineageTag: 42817c78-d688-4951-b578-ee574e8b8c6d
		summarizeBy: none
		sourceColumn: Staging_ModelData[DisplayName]

	column UserKey
		dataType: int64
		isHidden
		lineageTag: b9941af9-ea9a-4405-8d75-7feb6ea2ea08
		summarizeBy: none
		sourceColumn: Staging_ModelData[UserKey]

	column TotalTasks
		dataType: int64
		formatString: #,0
		lineageTag: 94473167-3004-445a-9833-e8f078179518
		summarizeBy: sum
		sourceColumn: Staging_ModelData[TotalTasks]

	column ScheduledTasks
		dataType: int64
		formatString: #,0
		lineageTag: dd2653d8-54db-4df7-807f-64c1bac9c065
		summarizeBy: sum
		sourceColumn: Staging_ModelData[ScheduledTasks]

	column UserInitiatedTasks
		dataType: int64
		formatString: #,0
		lineageTag: 45ab13f0-5b5e-44a8-bb86-317dad64109d
		summarizeBy: sum
		sourceColumn: Staging_ModelData[UserInitiatedTasks]

	column ActiveDays
		dataType: int64
		formatString: #,0
		lineageTag: ac92d1b6-f5e2-4348-9ba8-0b5af99e5ad8
		summarizeBy: sum
		sourceColumn: Staging_ModelData[ActiveDays]

	column LastActivityDate
		dataType: dateTime
		formatString: General Date
		lineageTag: 005c6fb4-1ccd-404e-b1ed-c16ac84cdd53
		summarizeBy: none
		sourceColumn: Staging_ModelData[LastActivityDate]

	/// Per-row, not whole-table, so a future export with a mix of matched and unmatched
	/// UserPrincipalName values is disclosed accurately rather than uniformly.
	column DataQuality
		dataType: string
		lineageTag: 360aca24-13e6-4c5d-98ff-13c1722627b7
		summarizeBy: none
		sourceColumn: Staging_ModelData[DataQuality]

	column _RowId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: bf87f0f1-2e95-4564-9459-ddd5c8b8dac1
		summarizeBy: none
		sourceColumn: Staging_ModelData[_RowId]

	partition Fact_CoworkUsage = calculated
		mode: import
		source =
				SUMMARIZE(
					FILTER(
						Staging_ModelData,
						Staging_ModelData[_Entity] = "Fact_CoworkUsage"
					),
					Staging_ModelData[_RowId],
					Staging_ModelData[UserPrincipalName],
					Staging_ModelData[DisplayName],
					Staging_ModelData[UserKey],
					Staging_ModelData[TotalTasks],
					Staging_ModelData[ScheduledTasks],
					Staging_ModelData[UserInitiatedTasks],
					Staging_ModelData[ActiveDays],
					Staging_ModelData[LastActivityDate],
					Staging_ModelData[DataQuality]
				)

	annotation PBI_ResultType = Table
