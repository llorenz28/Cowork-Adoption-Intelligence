ref table 'Champion Tier'
ref table 'Assisted Min - Research'
ref table 'Assisted Min - Content'
ref table 'Assisted Min - Email'
ref table 'Assisted Min - Meetings'
ref table 'Assisted Min - Communications'
ref table 'Assisted Min - Specialized'
