ref table 'Cowork Skill Category Map'
ref table 'Prepaid Rate per Credit'
ref table 'Committed Credits'
ref table 'Prepaid Credits Procured'
ref table 'Allocation Model'
ref table 'Skill Adjustment %'
ref table Bridge_CoworkPlugin
ref table Bridge_CoworkResource
ref table Dim_CoworkSkill
