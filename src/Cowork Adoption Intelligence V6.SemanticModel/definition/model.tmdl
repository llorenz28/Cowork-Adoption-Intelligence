model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolderPath","Cowork Adoption Purview File","Cowork Adoption Users File","fnGetBinary","fnPickOneLake","AsOfDate","CurrencyCode","DefaultRatePerCredit","fnFriendlyToolName","Dim_Date","Dim_Service","Dim_Policy","Dim_TaskCategory","Dim_CoworkTask","AsOf","Human Time Estimates","Value Constants","Metric Glossary","AppHost Category Map","Cowork Skill Category Map","CoworkSkillRules","CoworkOrchestrationSkills","fnClassifySkill","fnCategoryFromArtifact","Staging_ModelData","Champion Tier","Dim_WorkTiming"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["TMDL-Extension","DevMode","MCP-PBIModeling"]

ref table AsOf
ref table Dim_Date
ref table Dim_Policy
ref table Dim_Service
ref table Dim_TaskCategory
ref table Staging_ModelData
ref table CoworkClassification
ref table Dim_User
