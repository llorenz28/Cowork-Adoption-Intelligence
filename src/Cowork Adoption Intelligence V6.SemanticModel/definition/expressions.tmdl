/// Internal helper. Given a file path string, strips surrounding double quotes, auto-detects the
/// backend (Local / SharePoint / OneLake) from the path shape, and returns the file's binary
/// content via the appropriate connector (File.Contents / SharePoint.Files / Lakehouse.Contents).
/// Returns null for an empty/blank input so optional file parameters can short-circuit cleanly.
expression fnGetBinary =
		(filePath as nullable text) as nullable binary =>
		let
		    A_Trim    = if filePath = null then "" else Text.Trim(filePath),
		    // Strip surrounding ASCII or "smart" double quotes (Word/Outlook auto-correct safe).
		    A_Unquote = let s = A_Trim,
		                    L = Text.Length(s),
		                    quotes = {"""", "“", "”", "„", "‟"}
		                in  if L >= 2
		                       and List.Contains(quotes, Text.At(s, 0))
		                       and List.Contains(quotes, Text.At(s, L - 1))
		                    then Text.Middle(s, 1, L - 2)
		                    else s,
		    A_NoQuery = let qIdx = Text.PositionOfAny(A_Unquote, {"?", "#"})
		                in  if qIdx >= 0 then Text.Start(A_Unquote, qIdx) else A_Unquote,
		    // URL-decode %XX sequences. Collects raw bytes first, then re-assembles into
		    // a UTF-8-aware string so multi-byte characters (é, ñ, em-dash, emoji, etc.)
		    // round-trip correctly. Non-percent runs are emitted as-is.
		    HexVal    = (c as text) as number =>
		                    let n = Character.ToNumber(c)
		                    in  if n >= 48 and n <= 57 then n - 48
		                        else if n >= 65 and n <= 70 then n - 55
		                        else if n >= 97 and n <= 102 then n - 87
		                        else -1,
		    // Walk the string producing a list of segments: each segment is either
		    // {"t", text} (literal text run) or {"b", {byte,...}} (decoded bytes).
		    SegList   = let parts = Text.Split(A_NoQuery, "%"),
		                    head  = {{"t", parts{0}}},
		                    tail  = List.Skip(parts, 1)
		                in  List.Accumulate(tail, head, (acc, p) =>
		                        if Text.Length(p) >= 2 then
		                            let h1 = HexVal(Text.At(p, 0)),
		                                h2 = HexVal(Text.At(p, 1)),
		                                rest = Text.Middle(p, 2)
		                            in  if h1 >= 0 and h2 >= 0
		                                then acc & {{"b", {h1 * 16 + h2}}, {"t", rest}}
		                                else acc & {{"t", "%" & p}}
		                        else acc & {{"t", "%" & p}}),
		    // Coalesce adjacent byte segments so multi-byte UTF-8 chars combine.
		    SegMerged = List.Accumulate(SegList, {}, (acc, seg) =>
		                    if List.Count(acc) > 0
		                       and (List.Last(acc)){0} = "b"
		                       and seg{0} = "b"
		                    then List.RemoveLastN(acc, 1)
		                         & {{"b", (List.Last(acc)){1} & seg{1}}}
		                    else acc & {seg}),
		    A_Decoded = Text.Combine(List.Transform(SegMerged, (seg) =>
		                    if seg{0} = "t" then seg{1}
		                    else Text.FromBinary(Binary.FromList(seg{1}), TextEncoding.Utf8))),
		    Cleaned   = Text.Trim(A_Decoded),
		    Lower     = Text.Lower(Cleaned),

		    Result =
		        if Cleaned = "" then
		            null

		        // ---- OneLake (https://[region-]onelake.dfs.fabric.microsoft.com/<ws>/<lh>.Lakehouse/Files/<rel>) ----
		        else if Text.Contains(Lower, "onelake.dfs.fabric.microsoft.com")
		             and Text.StartsWith(Lower, "https://") then
		            let
		                NoScheme = Text.Middle(Cleaned, 8),
		                NoTrail  = if Text.EndsWith(NoScheme, "/") then Text.Start(NoScheme, Text.Length(NoScheme) - 1) else NoScheme,
		                Parts    = Text.Split(NoTrail, "/"),
		                Ws       = Parts{1},
		                ItemSeg  = Parts{2},
		                ItemLow  = Text.Lower(ItemSeg),
		                LhName   = if Text.EndsWith(ItemLow, ".lakehouse")
		                              then Text.Start(ItemSeg, Text.Length(ItemSeg) - 10)
		                           else if Text.EndsWith(ItemLow, ".warehouse")
		                              then Text.Start(ItemSeg, Text.Length(ItemSeg) - 10)
		                           else ItemSeg,
		                Rel      = Text.Combine(List.Skip(Parts, 4), "/"),
		                Picked   = fnPickOneLake(Ws, LhName, Rel, Cleaned)
		            in
		                Picked

		        // ---- OneLake (abfss://<ws>@onelake.dfs.fabric.microsoft.com/<lh>.Lakehouse/Files/<rel>) ----
		        else if Text.StartsWith(Lower, "abfss://")
		             and Text.Contains(Lower, "onelake.dfs.fabric.microsoft.com") then
		            let
		                NoScheme  = Text.Middle(Cleaned, 8),
		                NoTrail   = if Text.EndsWith(NoScheme, "/") then Text.Start(NoScheme, Text.Length(NoScheme) - 1) else NoScheme,
		                AtIdx     = Text.PositionOf(NoTrail, "@"),
		                Ws        = Text.Start(NoTrail, AtIdx),
		                AfterHost = Text.Middle(NoTrail, Text.PositionOf(NoTrail, "/") + 1),
		                Parts     = Text.Split(AfterHost, "/"),
		                ItemSeg   = Parts{0},
		                ItemLow   = Text.Lower(ItemSeg),
		                LhName    = if Text.EndsWith(ItemLow, ".lakehouse")
		                               then Text.Start(ItemSeg, Text.Length(ItemSeg) - 10)
		                            else if Text.EndsWith(ItemLow, ".warehouse")
		                               then Text.Start(ItemSeg, Text.Length(ItemSeg) - 10)
		                            else ItemSeg,
		                Rel       = Text.Combine(List.Skip(Parts, 2), "/"),
		                Picked    = fnPickOneLake(Ws, LhName, Rel, Cleaned)
		            in
		                Picked

		        // ---- SharePoint (fetch the file directly by URL - no whole-site scan) ----
		        else if Text.StartsWith(Lower, "https://")
		             and Text.Contains(Lower, ".sharepoint.com/") then
		            Web.Contents(Cleaned)

		        // ---- Local (drive letter, UNC, or anything else) ----
		        else
		            File.Contents(Cleaned)
		in
		    Result
	lineageTag: 7c0e4a6f-0001-4f2a-9b0e-fabricsp00001

	annotation PBI_ResultType = Function

/// Internal helper. Resolves a OneLake Files-relative path to a binary, tolerating
/// trailing slashes, missing/extra slash on [Path], and case differences on the
/// relative path. Workspace lookup tries by ID first, then by name. Raises a
/// descriptive error if not found.
expression fnPickOneLake =
		(ws as text, lhName as text, rel as text, original as text) as binary =>
		let
		    RelTrim   = if Text.EndsWith(rel, "/") then Text.Start(rel, Text.Length(rel) - 1) else rel,
		    Target    = Text.Lower("Files/" & RelTrim),
		    Root      = Lakehouse.Contents(null),
		    Workspace = try Root{[workspaceId   = ws]}[Data]
		                otherwise Root{[workspaceName = ws]}[Data],
		    Lakehouse_ = Workspace{[lakehouseName = lhName]}[Data],
		    Files     = Lakehouse_{[Id = "Files"]}[Data],
		    // Normalize each row's full path: ensure exactly one slash between [Path] and [Name],
		    // strip any trailing slash, lowercase for case-insensitive comparison.
		    Norm      = (p as text, n as text) as text =>
		                    let joined = if Text.EndsWith(p, "/") then p & n else p & "/" & n,
		                        notrl  = if Text.EndsWith(joined, "/") then Text.Start(joined, Text.Length(joined) - 1) else joined
		                    in  Text.Lower(notrl),
		    Match     = Table.SelectRows(Files, each Norm([Path], [Name]) = Target),
		    Picked    = if Table.RowCount(Match) = 0
		                then error "File not found in OneLake: " & original
		                else Match{0}[Content]
		in
		    Picked
	lineageTag: 7c0e4a6f-0002-4f2a-9b0e-fabriconelake

	annotation PBI_ResultType = Function

