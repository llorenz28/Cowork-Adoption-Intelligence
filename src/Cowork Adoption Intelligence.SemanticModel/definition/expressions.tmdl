/// Exact lower-case runtime machinery names that never label user activity.
expression CoworkOrchestrationSkills =
		{
			"read_agent", "write_agent", "task", "report_intent", "builtin", "",
			"tool_search_tool", "skill", "askuserquestion",
			"read_bash", "stop_bash", "list_agents", "apply_patch",
			"taskget", "tasklist"
		}
	lineageTag: 8961caf5-33ee-487a-8fe2-cec10d9fa99b

	annotation PBI_ResultType = List

/// Returns the first priority-ranked rule matching a plugin name.
expression fnClassifySkill =
		let
			fn = (pluginName as nullable text) as nullable record =>
				let
					n = Text.Lower(Text.Trim(if pluginName = null then "" else pluginName)),
					Hits = Table.SelectRows(CoworkSkillRules, each
						([Match] = "exact" and n = [Pattern]) or
						([Match] = "prefix" and Text.StartsWith(n, [Pattern])) or
						([Match] = "contains" and Text.Contains(n, [Pattern]))
					)
				in
					if Table.IsEmpty(Hits) then null else Table.First(Hits)
		in
			fn
	lineageTag: fa4d0e97-ca6a-4b61-8f93-1913dad15d5c

	annotation PBI_ResultType = Function

/// Classifies only authored artifacts under /documents/cowork/.
expression fnCategoryFromArtifact =
		let
			fn = (resources as list) as nullable text =>
				let
					Urls = List.Transform(resources, each Text.Lower(try _[SiteUrl] otherwise "")),
					Mine = List.Select(Urls, each Text.Contains(_, "/documents/cowork/")),
					Exts = List.Transform(Mine, each Text.AfterDelimiter(_, ".", {0, RelativePosition.FromEnd}))
				in
					if List.ContainsAny(Exts, {"py","ps1","js","ts","sql","ipynb","yml","yaml"}) then "Write or debug code"
					else if List.ContainsAny(Exts, {"xlsx","xlsm","csv","tsv","pbix","pbit"}) then "Analysis & Research"
					else if List.ContainsAny(Exts, {"docx","pptx","pdf","md","html","page","png","jpg"}) then "Document & content creation"
					else null
		in
			fn
	lineageTag: 52a566fc-fdc9-45fd-990b-b093cb5cd5c3

	annotation PBI_ResultType = Function
