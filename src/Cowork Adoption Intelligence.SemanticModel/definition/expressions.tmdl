/// The only setup input shown when the template opens. Put the Purview audit,
/// consumption, usage, optional organization, and identity CSVs anywhere under
/// this folder. The model discovers the optional exports by filename or schema.
expression DataFolderPath = "C:\CoworkValueIntelligence\sample_data" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true, Description="DATA FOLDER — REQUIRED. Select one folder containing your Purview Audit Search export CSVs and any optional Consumption - Users, Cowork usage, organization, and cowork_users.csv identity exports. Files may be placed in subfolders; supported exports are discovered automatically."]
	lineageTag: 461f7acc-9867-4a36-9132-5ebb84c8ffa6

	annotation PBI_ResultType = Text

/// Finds a CSV below DataFolderPath by preferred filename, then by required
/// headers. Returning null is intentional: optional sources degrade to an
/// explicit unavailable state in their consuming table.
expression fnFindCsvPath =
		let
			fn = (preferredNames as list, requiredColumns as list) as nullable text =>
				let
					Files = try Folder.Files(DataFolderPath) otherwise #table(type table [Content = binary, Name = text, Extension = text, #"Folder Path" = text], {}),
					CsvFiles = Table.SelectRows(Files, each Text.Lower([Extension]) = ".csv"),
					PreferredLower = List.Transform(preferredNames, each Text.Lower(Text.From(_))),
					HasRequiredColumns = (row as record) as logical =>
						let
							Parsed = try Table.PromoteHeaders(
								Csv.Document(row[Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
								[PromoteAllScalars = true]
							) otherwise null
						in
							Value.Is(Parsed, type table) and List.IsEmpty(List.Difference(requiredColumns, Table.ColumnNames(Parsed))),
					Named = Table.SelectRows(CsvFiles, each List.Contains(PreferredLower, Text.Lower([Name]))),
					NamedValid = Table.SelectRows(Named, each HasRequiredColumns(_)),
					SchemaValid = if Table.IsEmpty(NamedValid) then Table.SelectRows(CsvFiles, each HasRequiredColumns(_)) else NamedValid,
					Match = if Table.IsEmpty(SchemaValid) then null else SchemaValid{0}
				in
					if Match = null then null else Match[#"Folder Path"] & Match[Name]
		in
			fn
	lineageTag: a9f6bcaa-5519-45cb-8307-b08c8e59680c

