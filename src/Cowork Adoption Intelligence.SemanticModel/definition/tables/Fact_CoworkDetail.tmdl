	partition Fact_CoworkDetail = calculated
		mode: import
		source =
				ADDCOLUMNS(
					FILTER('Fact_CopilotAuditRaw', 'Fact_CopilotAuditRaw'[AppHost] = "cowork"),
					"Category",
						VAR mappedCategory = LOOKUPVALUE('Cowork Skill Category Map'[Category], 'Cowork Skill Category Map'[Plugin_FirstName], IF(ISBLANK('Fact_CopilotAuditRaw'[Plugin_FirstName]), "", 'Fact_CopilotAuditRaw'[Plugin_FirstName]))
						RETURN IF(ISBLANK(mappedCategory), "Unmapped", mappedCategory),
					"IsUnmapped",
						VAR mappedCategory2 = LOOKUPVALUE('Cowork Skill Category Map'[Category], 'Cowork Skill Category Map'[Plugin_FirstName], IF(ISBLANK('Fact_CopilotAuditRaw'[Plugin_FirstName]), "", 'Fact_CopilotAuditRaw'[Plugin_FirstName]))
						RETURN ISBLANK(mappedCategory2),
					"CategoryKey",
						VAR mappedCategory3 = LOOKUPVALUE('Cowork Skill Category Map'[Category], 'Cowork Skill Category Map'[Plugin_FirstName], IF(ISBLANK('Fact_CopilotAuditRaw'[Plugin_FirstName]), "", 'Fact_CopilotAuditRaw'[Plugin_FirstName]))
						RETURN IF(ISBLANK(mappedCategory3), 8, LOOKUPVALUE(Dim_TaskCategory[CategoryKey], Dim_TaskCategory[Category], mappedCategory3))

				)
