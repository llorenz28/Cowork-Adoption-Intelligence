			        NOT ISBLANK(_week) &&
			        NOT ISBLANK(_lastWeek) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        [Cowork Low Users]
			    )
		formatString: #,0
		lineageTag: ee7de751-f863-5a98-aa5d-92e1176b5c63

	measure 'Cowork Inactive Users Trend' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE(
			                [Cowork Active Users],
			                REMOVEFILTERS(Dim_User[Department])
			            ) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        NOT ISBLANK(_lastWeek) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        [Cowork Inactive Users]
			    )
		formatString: #,0
		lineageTag: 86b7c372-9e39-5539-b2c0-5e98c1f084d1

	measure 'Cowork Insufficient Sample Users Trend' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE(
			                [Cowork Active Users],
			                REMOVEFILTERS(Dim_User[Department])
			            ) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        NOT ISBLANK(_lastWeek) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        [Cowork Insufficient Sample Users]
			    )
		formatString: #,0
		lineageTag: 387e6b46-c5a9-426b-ba36-3faf2a89c6ac

	/// Distinct Cowork threads at the activity grain so date, org, user-tier, and LLM filters all propagate.
	measure 'Cowork Tasks in Filter Context' = DISTINCTCOUNT(Fact_CoworkDetail[ThreadId])
		formatString: #,0
		lineageTag: 848bedea-9461-55c3-8b51-d6dfb57b76ab

	/// Users whose first observed Cowork activity occurred in the selected week.
	measure 'Cowork Weekly New Users (Last 12 Weeks)' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			VAR _currentUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week
			    )
			VAR _priorUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] < _week
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        COALESCE(COUNTROWS(EXCEPT(_currentUsers, _priorUsers)), 0)
			    )
		formatString: #,0
		lineageTag: 98a0caf4-a7de-4557-81dd-4b663addd748

	/// Users active in both the selected week and the immediately preceding week.
	measure 'Cowork Weekly Retained Users (Last 12 Weeks)' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			VAR _currentUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week
			    )
			VAR _previousUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week - 7
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        COALESCE(COUNTROWS(INTERSECT(_currentUsers, _previousUsers)), 0)
			    )
		formatString: #,0
		lineageTag: 20158a8c-fbce-40f2-aa98-d0ab7a97dcce

	/// Users active in the selected week after missing the prior week but having earlier activity.
	measure 'Cowork Weekly Resurrected Users (Last 12 Weeks)' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			VAR _currentUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week
			    )
			VAR _previousUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week - 7
			    )
			VAR _earlierUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] < _week - 7
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        COALESCE(
			            COUNTROWS(
			                INTERSECT(
			                    EXCEPT(_currentUsers, _previousUsers),
			                    _earlierUsers
			                )
			            ),
			            0
			        )
			    )
		formatString: #,0
		lineageTag: b39b6955-e7c2-4607-a917-cd2dd59b25a3

	/// Prior-week users who did not return in the selected week, shown below zero.
	measure 'Cowork Weekly Churned Users (Last 12 Weeks)' =
			VAR _week = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _lastWeek =
			    MAXX(
			        FILTER(
			            ALLSELECTED(Dim_Date[WeekStart]),
			            CALCULATE([Cowork Active Users]) > 0
			        ),
			        Dim_Date[WeekStart]
			    )
			VAR _currentUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week
			    )
			VAR _previousUsers =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(Fact_CoworkDetail[Audit_UserId]),
			            NOT ISBLANK(Fact_CoworkDetail[Audit_UserId])
			        ),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _week - 7
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_week) &&
			        _week >= _lastWeek - 77 &&
			        _week <= _lastWeek,
			        -COALESCE(COUNTROWS(EXCEPT(_previousUsers, _currentUsers)), 0)
			    )
		formatString: #,0;-#,0;0
		lineageTag: 82615efe-ccc7-4b8d-afd4-141a86d2ae0f

