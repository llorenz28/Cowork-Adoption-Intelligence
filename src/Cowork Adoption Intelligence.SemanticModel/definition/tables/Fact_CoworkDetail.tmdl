		lineageTag: e5db9218-62d9-4e72-8321-4c8ba561d61c

	measure 'Cowork Prompt Count' = SUM(Fact_CoworkDetail[Message_PromptCount])
		lineageTag: 2f5cab6a-8fcd-45ef-acf4-dabc0fbf762e

	measure 'Cowork Skill Invocations' = CALCULATE(COUNTROWS(Fact_CoworkDetail), FILTER(Fact_CoworkDetail, Fact_CoworkDetail[Plugin_Count] > 0))
		lineageTag: cc9343ed-4aa4-4cc4-a95d-11444d0ecb23

	measure 'Cowork Unmapped Count' = CALCULATE(COUNTROWS(Fact_CoworkDetail), FILTER(Fact_CoworkDetail, Fact_CoworkDetail[IsUnmapped] = TRUE))
		lineageTag: ebbe79a4-d945-4051-a72e-5cafd6906745

	/// Comparator (re-anchored, not ambient DATEADD): month-over-month change in real active-user
	/// count, anchored to the latest month with real activity vs. the month before it -- NOT
	/// "today's" calendar month, which may have zero real rows once Dim_Date's range extends past
	/// the last real activity (this is the same fix already proven on 'Tasks MoM %'/'Duration MoM %'
	/// in Fact_CoworkThread.tmdl; see bug pattern #14 in plan.md for the full rationale).
	measure 'Active Users MoM %' =
			VAR _lastActiveMonth =
			    MAXX(
			        FILTER(ALL(Dim_Date[MonthStart]), CALCULATE([Cowork Active Users]) > 0),
			        Dim_Date[MonthStart]
			    )
			VAR _prevMonth = EDATE(_lastActiveMonth, -1)
			VAR _cur = CALCULATE([Cowork Active Users], ALL(Dim_Date), Dim_Date[MonthStart] = _lastActiveMonth)
			VAR _prev = CALCULATE([Cowork Active Users], ALL(Dim_Date), Dim_Date[MonthStart] = _prevMonth)
			RETURN DIVIDE(_cur - _prev, _prev)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 0a3ffd69-8326-43f7-b21f-05de8fa3df90

	measure 'Active Users MoM % Display' = IF(ISBLANK([Active Users MoM %]), "–", IF([Active Users MoM %] > 0, "▲ " & FORMAT([Active Users MoM %], "0.0%"), IF([Active Users MoM %] < 0, "▼ " & FORMAT(ABS([Active Users MoM %]), "0.0%"), "— 0.0%")))
		lineageTag: 65942079-fa6c-4f6e-bab0-75756b25765f

	measure 'Active Users MoM % Color' = IF(ISBLANK([Active Users MoM %]) || [Active Users MoM %] = 0, "#5C6B7F", IF([Active Users MoM %] > 0, "#107C10", "#A80000"))
		lineageTag: 778c500b-e29b-4afe-9ce2-8f8227d70805

	measure 'Average Weekly Prompts' = AVERAGEX(VALUES(Dim_Date[WeekStart]), [Cowork Prompt Count])
		formatString: #,0.0
