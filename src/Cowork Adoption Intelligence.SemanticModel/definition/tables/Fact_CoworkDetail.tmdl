	measure 'Prompts per Active User per Week' = AVERAGEX(VALUES(Dim_Date[WeekStart]), DIVIDE([Cowork Prompt Count], [Cowork Active Users]))
		formatString: #,0.0
		lineageTag: 5b58d413-3f29-5162-908e-bf21302d4efc

	measure 'Average Active Days per User per Week' =
			AVERAGEX(
			    VALUES(Dim_Date[WeekStart]),
			    AVERAGEX(
			        VALUES(Fact_CoworkDetail[Audit_UserId]),
			        CALCULATE(DISTINCTCOUNT(Fact_CoworkDetail[DateKey]))
			    )
			)
		formatString: #,0.0
		lineageTag: 37b3ba68-728b-5819-978d-2269abff9ddb

	measure 'Cowork Weekly Return Rate' =
			VAR _axisWeek = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _currentWeek =
			    IF(
			        NOT ISBLANK(_axisWeek),
			        _axisWeek,
			        MAXX(
			            FILTER(
			                ALLSELECTED(Dim_Date[WeekStart]),
			                CALCULATE([Cowork Active Users]) > 0
			            ),
			            Dim_Date[WeekStart]
			        )
			    )
			VAR _previousWeek = _currentWeek - 7
			VAR _currentUsers =
			    CALCULATETABLE(
			        VALUES(Fact_CoworkDetail[Audit_UserId]),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _currentWeek
			    )
			VAR _previousUsers =
			    CALCULATETABLE(
			        VALUES(Fact_CoworkDetail[Audit_UserId]),
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _previousWeek
			    )
			RETURN
			    DIVIDE(
			        COUNTROWS(INTERSECT(_currentUsers, _previousUsers)),
			        COUNTROWS(_previousUsers)
			    )
		formatString: 0.0%
		lineageTag: 7aee0884-46b0-5518-b46b-2a03cf26f65d

	measure 'Cowork Licensed Adoption %' = DIVIDE([Cowork Active Users], [Licensed Users])
		formatString: 0.0%
		lineageTag: b54e09b7-4a62-56ca-b69b-d639cd3e9c25

	/// Weekly active users at the current date and organizational filter grain.
	measure 'Cowork Weekly Active Users' =
			VAR _axisWeek = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _currentWeek =
			    IF(
			        NOT ISBLANK(_axisWeek),
			        _axisWeek,
			        MAXX(
			            FILTER(
			                ALLSELECTED(Dim_Date[WeekStart]),
			                CALCULATE([Cowork Active Users]) > 0
			            ),
			            Dim_Date[WeekStart]
			        )
			    )
			RETURN
			    CALCULATE(
			        [Cowork Active Users],
			        REMOVEFILTERS(Dim_Date),
			        Dim_Date[WeekStart] = _currentWeek
			    )
		formatString: #,0
		lineageTag: 6bf4c0fc-c3e4-5d40-b46b-bdfa0215416f

