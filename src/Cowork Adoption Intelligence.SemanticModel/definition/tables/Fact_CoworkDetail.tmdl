	/// Percentile rank of prompt volume within the current selected user population.
	/// Returns blank below the same 20-active-user floor used by Value Percentile.
	measure 'Cowork User Prompt Percentile' =
			VAR _pop =
			    COUNTROWS(
			        FILTER(
			            ALLSELECTED(Dim_User[UserKey]),
			            [Cowork Prompt Count] > 0
			        )
			    )
			VAR _rank =
			    RANKX(
			        FILTER(
			            ALLSELECTED(Dim_User[UserKey]),
			            [Cowork Prompt Count] > 0
			        ),
			        [Cowork Prompt Count],
			        ,
			        DESC
			    )
			RETURN
			    IF(_pop < 20, BLANK(), DIVIDE(_pop - _rank, _pop - 1))
		formatString: 0.0%
		isHidden
		lineageTag: 5701e3e4-31d9-4ff8-a7ae-e6074b1edb18

	/// Rolling 12-week Cowork usage tier, evaluated per user and per week.
	measure 'Cowork User Usage Tier' =
			VAR _axisWeek = SELECTEDVALUE(Dim_Date[WeekStart])
			VAR _endWeek =
			    IF(
			        NOT ISBLANK(_axisWeek),
			        _axisWeek,
			        MAXX(
			            FILTER(
			                ALLSELECTED(Dim_Date[WeekStart]),
			                CALCULATE([Cowork Active Users]) > 0
			            ),
			            Dim_Date[WeekStart]
			        )
			    )
			VAR _startDate = _endWeek - 77
			VAR _endDate = _endWeek + 6
			VAR _prompts =
			    CALCULATE(
			        [Cowork Prompt Count],
			        REMOVEFILTERS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], _startDate, _endDate)
			    )
			VAR _activeWeeks =
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                VALUES(Dim_Date[WeekStart]),
			                REMOVEFILTERS(Dim_Date),
			                DATESBETWEEN(Dim_Date[Date], _startDate, _endDate)
			            ),
			            CALCULATE([Cowork Prompt Count]) > 0
			        )
			    )
			VAR _p =
			    CALCULATE(
			        [Cowork User Prompt Percentile],
			        REMOVEFILTERS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], _startDate, _endDate)
			    )
			RETURN
			    IF(
			        ISBLANK(_endWeek),
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            COALESCE(_prompts, 0) = 0, "Inactive",
			            ISBLANK(_p), "Insufficient sample",
			            _p >= 0.90 && _activeWeeks >= 9, "Power users",
			            _p >= 0.60 && _activeWeeks >= 9, "Habitual users",
			            _p >= 0.20, "Novice users",
			            "Low users"
			        )
			    )
		isHidden
		lineageTag: 094dcc14-e2b4-502a-a275-70d2840d7163

