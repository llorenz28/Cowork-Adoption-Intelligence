	/// Highest-priority customer-facing tool observed in the thread after
	/// orchestration tools are excluded.
	column PrimaryBusinessTool
		dataType: string
		isHidden
		lineageTag: f5065cce-b07f-44ae-85f6-c86188809d1f
		summarizeBy: none
		sourceColumn: Staging_ModelData[PrimaryBusinessTool]

