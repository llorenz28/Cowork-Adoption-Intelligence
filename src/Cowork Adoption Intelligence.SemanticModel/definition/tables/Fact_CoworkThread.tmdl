		summarizeBy: sum
		sourceColumn: Staging_ModelData[ResourceCount]

	column PluginCount
		dataType: int64
		formatString: #,0
		lineageTag: e347e0f5-b2fc-40fe-8dea-83a0321801c4
		summarizeBy: sum
		sourceColumn: Staging_ModelData[PluginCount]

	column DurationMin
		dataType: double
		formatString: #,0.0
		lineageTag: cb637f69-d51f-413a-a3b9-fbba52c04934
