	column RecordCount
		dataType: int64
		formatString: #,0
		lineageTag: 76f67b23-5988-454e-9fe9-6cde9075d80f
		summarizeBy: sum
		sourceColumn: Staging_ModelData[RecordCount]

	column PromptCount
		dataType: int64
