	column _RowId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8ed4a908-ef51-4008-b92b-e6ea21c88674
		summarizeBy: none
		sourceColumn: Staging_ModelData[_RowId]

	partition Fact_CoworkThread = calculated
		mode: import
		source =
				SUMMARIZE(
					FILTER(
						Staging_ModelData,
						Staging_ModelData[_Entity] = "Fact_CoworkThread"
					),
					Staging_ModelData[_RowId],
					Staging_ModelData[ThreadId],
					Staging_ModelData[UserKey],
					Staging_ModelData[DateKey],
					Staging_ModelData[WeekStartDate],
					Staging_ModelData[StartedAt],
					Staging_ModelData[EndedAt],
					Staging_ModelData[RecordCount],
					Staging_ModelData[PromptCount],
					Staging_ModelData[ResourceCount],
					Staging_ModelData[PluginCount],
					Staging_ModelData[DurationMin],
					Staging_ModelData[PrimarySkill],
					Staging_ModelData[PrimaryBusinessTool],
					Staging_ModelData[PrimarySkillDisplayName],
					Staging_ModelData[BusinessBehavior],
					Staging_ModelData[BehaviorConfidence],
					Staging_ModelData[PrimaryCategory],
					Staging_ModelData[ThreadCategory],
					Staging_ModelData[ThreadCategoryKey],
					Staging_ModelData[TaskClassification],
					Staging_ModelData[BusinessToolCount],
					Staging_ModelData[UnclassifiedToolCount],
					Staging_ModelData[OrchestrationToolCount]
				)

	annotation PBI_ResultType = Exception
