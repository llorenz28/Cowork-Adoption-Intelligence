	column UserDateKey
		dataType: string
		isHidden
		lineageTag: 60f4d304-b1cb-4164-9396-92fae42a760c
		summarizeBy: none
		sourceColumn: UserDateKey

	partition Staging_ModelData = m
		mode: import
		source =
				let
					ManifestPath = PreprocessedOutputPath & "\\manifest.json",
					ManifestAttempt = try Json.Document(File.Contents(ManifestPath)),
					Manifest =
						if ManifestAttempt[HasError] then
							error Error.Record("PreprocessorManifest", "The Cowork preprocessor manifest could not be read.", [Path = ManifestPath, Message = try ManifestAttempt[Error][Message] otherwise "Unknown manifest error"])
						else ManifestAttempt[Value],
					ManifestFormat = try Manifest[format] otherwise null,
					ValidatedManifest = if ManifestFormat <> "cowork-python-preprocessor-manifest-v1" then error Error.Record("PreprocessorManifest", "The output manifest format is unsupported.", [Path = ManifestPath, Format = ManifestFormat]) else Manifest,
					FolderAttempt = try Folder.Files(PreprocessedOutputPath),
					FolderFiles = if FolderAttempt[HasError] then error Error.Record("PreprocessedFolderAccess", "PreprocessedOutputPath could not be enumerated.", [Path = PreprocessedOutputPath, Message = try FolderAttempt[Error][Message] otherwise "Unknown folder access error"]) else FolderAttempt[Value],
					EntityFiles = Table.Sort(
						Table.SelectRows(FolderFiles, each Text.Lower([Extension]) = ".csv" and Text.StartsWith(Text.Lower([Name]), "entity-") and not (try Record.FieldOrDefault([Attributes], "Hidden", false) otherwise false)),
						{{"Folder Path", Order.Ascending}, {"Name", Order.Ascending}}
					),
					ValidatedFiles = if Table.IsEmpty(EntityFiles) then error Error.Record("PreprocessedSource", "No entity-*.csv files were found.", [Path = PreprocessedOutputPath]) else EntityFiles,
					ParseEntity = (file as record) as table =>
						let
							Attempt = try Table.PromoteHeaders(Csv.Document(Binary.Buffer(file[Content]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
						in
							if Attempt[HasError] then error Error.Record("PreprocessedCsv", "A preprocessed entity CSV could not be parsed.", [File = file[Name], Message = try Attempt[Error][Message] otherwise "Unknown CSV error"]) else Attempt[Value],
					Parsed = List.Transform(Table.ToRecords(ValidatedFiles), each ParseEntity(_)),
					Combined = Table.Combine(Parsed),
					ContractColumns = {"_Entity", "_RowId"},
					MissingContractColumns = List.Difference(ContractColumns, Table.ColumnNames(Combined)),
					ValidatedCombined = if not List.IsEmpty(MissingContractColumns) then error Error.Record("PreprocessedContract", "Preprocessed entity files are missing required contract columns.", [Columns = Text.Combine(MissingContractColumns, ", ")]) else Combined,
					TypeMap = {
						{"_Entity", type text},
						{"_RowId", Int64.Type},
