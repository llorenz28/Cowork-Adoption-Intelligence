	column _RowId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ac8de9f1-0a0e-41d6-a60d-8aafd84acedc
		summarizeBy: none
		sourceColumn: Staging_ModelData[_RowId]

	partition Fact_CopilotAuditRaw = calculated
		mode: import
		source =
				SUMMARIZE(
					FILTER(
						Staging_ModelData,
						Staging_ModelData[_Entity] = "Fact_CopilotAuditRaw"
					),
					Staging_ModelData[_RowId],
					Staging_ModelData[RecordId],
					Staging_ModelData[CreationDateParsed],
					Staging_ModelData[DateKey],
					Staging_ModelData[Audit_UserId],
					Staging_ModelData[Audit_UserId_Normalized],
					Staging_ModelData[UserKey],
					Staging_ModelData[AppHost],
					Staging_ModelData[Workload],
					Staging_ModelData[ClientRegion],
					Staging_ModelData[AppIdentity],
					Staging_ModelData[ThreadId],
					Staging_ModelData[LicenseType],
					Staging_ModelData[Message_Count],
					Staging_ModelData[Message_PromptCount],
					Staging_ModelData[Plugin_Count],
					Staging_ModelData[Plugin_FirstId],
					Staging_ModelData[Plugin_FirstName],
					Staging_ModelData[Resource_Count],
					Staging_ModelData[AccessedResource_FirstSiteUrl],
					Staging_ModelData[AccessedResource_FirstAction],
					Staging_ModelData[ModelProviderName]
				)

	annotation PBI_ResultType = Exception
