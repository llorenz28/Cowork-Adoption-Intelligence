		lineageTag: c3f1a001-0a11-4a11-9a11-1a11c3f1a015
		summarizeBy: sum
		sourceColumn: Staging_ModelData[Message_PromptCount]

	column Plugin_Count
		dataType: int64
		formatString: #,0
		lineageTag: c3f1a001-0a11-4a11-9a11-1a11c3f1a016
		summarizeBy: sum
		sourceColumn: Staging_ModelData[Plugin_Count]

	column Plugin_FirstId
		dataType: string
		isHidden
		lineageTag: c3f1a001-0a11-4a11-9a11-1a11c3f1a017
		summarizeBy: none
		sourceColumn: Staging_ModelData[Plugin_FirstId]

	column Plugin_FirstName
		dataType: string
