	/// Per-row disclosure, mirrors Fact_CoworkUsage[DataQuality].
	column DataQuality
		dataType: string
		lineageTag: bca98ef4-584d-4e12-be43-6f93bf0d9977
		summarizeBy: none
		sourceColumn: Staging_ModelData[DataQuality]

	column _RowId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 349e4b31-4c98-4241-9aa5-9bf712c28e16
		summarizeBy: none
		sourceColumn: Staging_ModelData[_RowId]

	partition Dim_UserOrg = calculated
		mode: import
		source =
				SUMMARIZE(
					FILTER(
						Staging_ModelData,
						Staging_ModelData[_Entity] = "Dim_UserOrg"
					),
					Staging_ModelData[_RowId],
					Staging_ModelData[UserPrincipalName],
					Staging_ModelData[UserKey],
					Staging_ModelData[DisplayName],
					Staging_ModelData[Department],
					Staging_ModelData[JobTitle],
					Staging_ModelData[JobFamily],
					Staging_ModelData[City],
					Staging_ModelData[Country],
					Staging_ModelData[CostCenter],
					Staging_ModelData[Manager],
					Staging_ModelData[BusinessUnit],
					Staging_ModelData[DataQuality]
				)

	annotation PBI_ResultType = Table
