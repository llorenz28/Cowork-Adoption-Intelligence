table Dim_UserOrg
	lineageTag: 13a4a1b0-9006-46ce-8221-7a75c4223aa4

	measure 'Cowork Users With Org Data' = COUNTROWS(Dim_UserOrg)
		formatString: #,0
		lineageTag: c2a5e7af-e760-4be2-80ff-7b88dbe58bad

	column UserPrincipalName
		dataType: string
		lineageTag: a179564b-f6e0-47fb-aca2-b0d3391a198c
