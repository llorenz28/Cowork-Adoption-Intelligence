table 'Momentum Consistency Weight'
	lineageTag: cea3716d-8613-4253-990f-87ca94918ffe

	/// Weight assigned to active-day consistency in the momentum index.
	measure 'Momentum Consistency Weight Value' = SELECTEDVALUE('Momentum Consistency Weight'[Momentum Consistency Weight], 0.25)
		formatString: 0%
		lineageTag: 74c3d62d-e406-4347-9c34-6ac4e5e056e2

	column 'Momentum Consistency Weight'
		dataType: decimal
		formatString: 0%
		lineageTag: 4898e93b-b733-416e-9cdc-82c6eb2e108b
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Momentum Consistency Weight' = calculated
		mode: import
		source = SELECTCOLUMNS(GENERATESERIES(0, 100, 1), "Value", CURRENCY(DIVIDE([Value], 100)))
