		level Manager
			lineageTag: d6050f72-0d86-4aac-8258-6fff3f5fe839
			column: Manager

	partition Dim_User = m
		mode: import
		source =
				let
					// Dynamically detect Cowork-eligible users from the connected Purview export.
					// Cannot reference
					// Fact_CopilotAuditRaw (the table) here: that table's own UserKey resolution joins against
					// Dim_User, so Dim_User referencing it back would create a circular dependency. This performs
					// an independent, lightweight scan of the same raw CopilotAuditFolderPath CSVs, extracting
					// only Operation/AppHost/UserId (not the full audit detail) to keep this necessary second pass
					// as light as possible. Trade-off, disclosed: refresh now reads the raw folder twice (once
					// here and once in Fact_CopilotAuditRaw.
					AuditFiles0 = Folder.Files(CopilotAuditFolderPath),
					AuditCsvOnly = Table.SelectRows(AuditFiles0, each Text.Lower(Text.End([Name], 4)) = ".csv"),
					ExtractCoworkUpns = (fileContent as binary) as list =>
						let
							Attempt = try
								let
									Parsed = Csv.Document(fileContent, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
									Promoted = Table.PromoteHeaders(Parsed, [PromoteAllScalars = true]),
									HasCols = Table.HasColumns(Promoted, {"Operation", "AuditData", "UserId"}),
									Base = if not HasCols then {} else
										let
											OnlyCopilot = Table.SelectRows(Promoted, each [Operation] = "CopilotInteraction"),
											AddJson = Table.AddColumn(OnlyCopilot, "_json", each let a = try Json.Document(Text.ToBinary([AuditData])) in if a[HasError] then null else a[Value]),
											OnlyValidJson = Table.SelectRows(AddJson, each [_json] <> null),
											AddCed = Table.AddColumn(OnlyValidJson, "_ced", each try [_json][CopilotEventData] otherwise null),
											AddAppHost = Table.AddColumn(AddCed, "_apphost", each if [_ced] = null then null else (try [_ced][AppHost] otherwise null)),
											OnlyCowork = Table.SelectRows(AddAppHost, each [_apphost] <> null and Text.Contains(Text.Lower(Text.Trim(Text.From([_apphost]))), "cowork")),
											Upns = List.Transform(OnlyCowork[UserId], each Text.Lower(Text.Trim(Text.From(_))))
										in
											Upns
								in
									Base
						in
							if Attempt[HasError] then {} else Attempt[Value],
					AllCoworkUpnLists = List.Transform(AuditCsvOnly[Content], each ExtractCoworkUpns(_)),
					DynamicCoworkUpns = List.Distinct(List.Combine(AllCoworkUpnLists)),
					CoworkUpnTable = Table.FromList(DynamicCoworkUpns, Splitter.SplitByNothing(), {"_upnNorm"}),

					Files0 = Folder.Files(IdentityEnrichmentFolderPath),

					// Gracefully degrade when optional identity enrichment files are absent.
					// Detected Cowork users remain in the model without Entra or organization enrichment.
					TryLoadReal = try
						let
							RealUsersFile = Table.SelectRows(Files0, each [Name] = "cowork_users.csv"){0},
							RealPromoted = Table.PromoteHeaders(Csv.Document(RealUsersFile[Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
							RealSelected = Table.SelectColumns(RealPromoted, {"id", "displayName", "userPrincipalName"}),
							RealRenamed = Table.RenameColumns(RealSelected, {{"id", "UserID"}, {"displayName", "DisplayName"}, {"userPrincipalName", "UserPrincipalName"}}),
							RealNormalized0 = Table.AddColumn(RealRenamed, "_upnNorm", each Text.Lower(Text.Trim([UserPrincipalName])), type text)
						in
							RealNormalized0
						otherwise
							#table({"UserID", "DisplayName", "UserPrincipalName", "_upnNorm"}, {}),
					RealNormalized = TryLoadReal,

					// LEFT JOIN (enrichment) from the dynamically-detected UPN set into the real Entra export --
					// a detected Cowork user is NEVER dropped just because they have no matching Entra row (e.g.
					// the customer did not supply an Entra export, or that specific account is missing from it).
					MergeIdentity = Table.NestedJoin(CoworkUpnTable, {"_upnNorm"}, RealNormalized, {"_upnNorm"}, "identity", JoinKind.LeftOuter),
					ExpandIdentity = Table.ExpandTableColumn(MergeIdentity, "identity", {"UserID", "DisplayName", "UserPrincipalName"}, {"UserID", "DisplayName", "UserPrincipalName"}),

					AddIdentityQuality = Table.AddColumn(ExpandIdentity, "IdentityDataQuality", each
						if [UserPrincipalName] <> null then "Real (confirmed via Entra export)"
						else "Real Cowork activity (Purview); no matching Entra identity record found", type text),
					FillUpn = Table.AddColumn(AddIdentityQuality, "UserPrincipalNameFinal", each if [UserPrincipalName] = null then [_upnNorm] else [UserPrincipalName], type text),
					FillDisplay = Table.AddColumn(FillUpn, "DisplayNameFinal", each if [DisplayName] = null then [_upnNorm] else [DisplayName], type text),

					RealFinal = Table.SelectColumns(FillDisplay, {"UserID", "DisplayNameFinal", "UserPrincipalNameFinal", "IdentityDataQuality"}),
					RealRenamedFinal = Table.RenameColumns(RealFinal, {{"DisplayNameFinal", "DisplayName"}, {"UserPrincipalNameFinal", "UserPrincipalName"}}),

					Indexed0 = Table.AddIndexColumn(RealRenamedFinal, "_idx", 0, 1, Int64.Type),

					// License assignment is a separate source domain. Until a real license export is
					// connected, retain an explicit unavailable state rather than positional sample data.
					AddCopilotLicense = Table.AddColumn(Indexed0, "CopilotLicense", each "Unknown", type text),
					AddLicenseSKU = Table.AddColumn(AddCopilotLicense, "LicenseSKU", each null, type nullable text),
					AddDemoDataQuality = Table.AddColumn(AddLicenseSKU, "DemographicDataQuality", each "Unavailable - no production license-assignment source connected", type text),

					Cleaned = Table.RemoveColumns(AddDemoDataQuality, {"_idx", "_upnNorm"}, MissingField.Ignore),
					Sorted = Table.Sort(Cleaned, {{"UserPrincipalName", Order.Ascending}}),
					Indexed = Table.AddIndexColumn(Sorted, "UserKey", 1, 1, Int64.Type)
				in
					Indexed

	annotation PBI_ResultType = Exception
