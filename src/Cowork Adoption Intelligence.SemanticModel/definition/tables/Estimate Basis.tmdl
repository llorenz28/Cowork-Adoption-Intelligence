table 'Estimate Basis'
	lineageTag: 0dad746c-898e-4b84-8e0d-5ca86aa0510c

	/// Customer-selected cited time-saved benchmark. Uses the cited midpoint when no single basis is selected.
	measure 'Estimate Basis Selected' = SELECTEDVALUE('Estimate Basis'[Estimate Basis], "Mid")
		lineageTag: 0a30e85f-94a3-486a-83f9-058765d38d3a

	column 'Estimate Basis'
		dataType: string
		lineageTag: b1bc193f-6da1-404c-9d81-9a9681b42bf3
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Estimate Basis' = calculated
		mode: import
		source = DATATABLE("Value", STRING, {{"Low"}, {"Mid"}, {"High"}})
