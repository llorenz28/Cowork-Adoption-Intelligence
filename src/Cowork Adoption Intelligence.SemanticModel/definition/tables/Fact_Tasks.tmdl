table Fact_Tasks
	lineageTag: ef4b14b7-2139-42d0-a6c4-0db2d3213f82

	measure 'Classified Business Tasks' = CALCULATE(SUM(Fact_Tasks[Tasks]), Fact_Tasks[TaskClassification] = "Business classified")
		formatString: #,0
		lineageTag: c31adfcb-82d0-4774-9043-ee5b96291530

	measure 'Unclassified Tasks' = CALCULATE(SUM(Fact_Tasks[Tasks]), Fact_Tasks[TaskClassification] = "Unclassified")
		formatString: #,0
		lineageTag: 677111e3-1cba-4b01-a16b-bb13490ca6e7

	measure 'Orchestration-Only Tasks' = CALCULATE(SUM(Fact_Tasks[Tasks]), Fact_Tasks[TaskClassification] = "Orchestration only")
		formatString: #,0
		lineageTag: d333882b-cd59-4771-b702-0200c895f138

	measure 'Task Classification Coverage %' = DIVIDE([Classified Business Tasks], SUM(Fact_Tasks[Tasks]))
		formatString: 0.0%
		lineageTag: f480fb5c-30e9-4b35-892d-67cd98d4382c

